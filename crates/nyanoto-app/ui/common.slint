// Метка строки на волне редактора.
export struct WaveMark {
    // Место на волне, 0…1.
    x: float,
    index: int,
    label: string,
    selected: bool,
}

export struct EditorLine {
    time: string,
    text: string,
    // Эту строку отметит следующее нажатие пробела.
    next: bool,
    selected: bool,
    // Строка звучит сейчас.
    current: bool,
    // Метка раньше меток строк выше.
    warn: bool,
}

// Строка списка глав и закладок.
export struct ChapterRow {
    time: string,
    name: string,
    // Закладку можно удалить, главу — нет.
    bookmark: bool,
    current: bool,
}

// Условие умного плейлиста в редакторе.
export struct SmartRow {
    kind: int,
    value: string,
    // У условия есть число или текст.
    needs-value: bool,
}

// Строка страницы «Здоровье»: заголовок раздела или находка.
export struct HealthRow {
    heading: bool,
    text: string,
    detail: string,
}

// Полоса эквалайзера.
export struct EqRow {
    kind: int,
    freq: string,
    gain: float,
    q: string,
}

// Строка истории: `day` непуст у первой записи дня — над ней заголовок дня.
export struct HistoryRow {
    day: string,
    time: string,
    title: string,
    detail: string,
    duration: string,
}

export struct LyricRow {
    text: string,
    current: bool,
}

export global Tr {
    in property <Words> w;
}

// Номера страниц (как в main.rs): 0 исполнители, 1 альбомы, 2 треки альбома, 3 поиск,
// 4 плейлисты, 5 треки плейлиста, 6 статистика, 7 настройки, 8 здоровье, 9 очередь, 10 папки.

// Номера списков треков для колбэков: 0 альбом, 1 поиск, 2 плейлист, 3 статистика.

export component Cover inherits Rectangle {
    in property <image> source;
    in property <string> letter;
    border-radius: Ui.radius;
    clip: true;
    // Подложка только под букву — под картинкой лишняя работа.
    background: root.source.width > 0 ? transparent : Theme.surface;
    Text {
        text: root.letter;
        visible: root.source.width == 0;
        font-size: root.height * 0.42;
        font-weight: 600;
        color: Theme.foreground;
        opacity: 0.45;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    CrossImage {
        source: root.source;
        width: 100%;
        height: 100%;
    }
}

// Строка списка: нажимается мышью, а экранный диктор видит её как кнопку.
export component Line inherits Rectangle {
    callback clicked;
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius;
    background: touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    property <bool> shown;
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: 160ms; easing: ease-out; }
    init => { self.shown = true; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    @children
}

// Маленькая текстовая кнопка внутри строки.
export component Mini inherits Rectangle {
    callback clicked;
    in property <string> text;
    in property <string> label;
    in property <bool> active;
    width: 28px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius;
    background: area.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-size: 15px;
        color: root.active ? Theme.accent : Theme.foreground;
        opacity: root.active || area.has-hover ? 1 : 0.55;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Кнопки с нарисованным значком: ► и ‖ в разных шрифтах разные.
// 0 играть, 1 пауза, 2 предыдущий, 3 следующий.
export component MediaButton inherits Rectangle {
    callback clicked;
    in property <int> kind;
    in property <bool> primary;
    in property <string> label;
    // Светлые поверх обложки в полном плеере.
    in property <bool> on-dark;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    width: 46px;
    height: 32px;
    border-radius: Ui.radius;
    background: root.primary ? Theme.accent : root.on-dark ? #ffffff2e : Theme.control;
    border-width: root.primary ? 0px : 1px;
    border-color: root.on-dark ? #ffffff40 : Theme.border;
    Rectangle {
        border-radius: parent.border-radius;
        background: area.pressed ? #00000030 : area.has-hover ? #ffffff1a : transparent;
        animate background { duration: 120ms; }
    }
    // «Играть» и «пауза» перетекают друг в друга; при нажатии значок чуть сжимается.
    property <length> side: area.pressed ? 12px : 14px;
    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.side;
        height: root.side;
        animate width, height { duration: 110ms; easing: ease-out; }
        viewbox-width: 14;
        viewbox-height: 14;
        fill: root.primary ? Theme.accent-foreground : root.on-dark ? #ffffff : Theme.foreground;
        commands: root.kind == 2 ? "M 1.5 1 L 3.5 1 L 3.5 13 L 1.5 13 Z M 12.5 1 L 12.5 13 L 4.5 7 Z"
            : root.kind == 3 ? "M 10.5 1 L 12.5 1 L 12.5 13 L 10.5 13 Z M 1.5 1 L 9.5 7 L 1.5 13 Z"
            : "M 3 1 L 12.5 7 L 3 13 Z";
        opacity: root.kind == 1 ? 0 : 1;
        animate opacity { duration: 160ms; easing: ease-out; }
    }
    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.side;
        height: root.side;
        animate width, height { duration: 110ms; easing: ease-out; }
        viewbox-width: 14;
        viewbox-height: 14;
        fill: root.primary ? Theme.accent-foreground : root.on-dark ? #ffffff : Theme.foreground;
        commands: "M 2.5 1 L 5.5 1 L 5.5 13 L 2.5 13 Z M 8.5 1 L 11.5 1 L 11.5 13 L 8.5 13 Z";
        opacity: root.kind == 1 ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Плашка «в разработке».
export component DevBadge inherits Rectangle {
    height: 18px;
    width: label.preferred-width + 14px;
    border-radius: 9px;
    background: Theme.foreground.with-alpha(0.1);
    label := Text {
        text: Tr.w.in-development;
        font-size: 11px;
        color: Theme.foreground;
        opacity: 0.75;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <bool> clickable;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius-small;
    // Lossy — грифель, CD — синий, Hi-Res — золото, DSD — фиолет, «подделка?» — красный.
    background: root.kind == 1 ? #d23b3b : root.kind == 2 ? transparent : root.kind == 3 ? #4f5662 : root.kind == 4 ? #2f6fd0 : root.kind == 5 ? #8a4fd0 : #c99a1f;
    border-width: root.kind == 2 ? 1px : 0px;
    border-color: Theme.foreground.transparentize(45%);
    width: label.preferred-width + 8px;
    height: 16px;
    TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: root.kind == 0 ? #000000 : root.kind == 2 ? Theme.foreground : root.kind == 3 ? #dde2ea : #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Значок «у трека есть текст песни» — перед значком качества.
export component LyricsMark inherits Rectangle {
    in property <length> glyph: 15px;
    in property <color> tint: Theme.foreground;
    width: root.glyph;
    height: root.glyph;
    accessible-role: text;
    accessible-label: Tr.w.has-lyrics;
    Icon {
        width: root.glyph;
        height: root.glyph;
        icon: Icons.lyrics;
        tint: root.tint;
        opacity: 0.75;
    }
}

export component ArtistLine inherits Line {
    in property <ArtistRow> data;
    label: root.data.name;
    height: 52px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Cover {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                letter: root.data.letter;
                source: root.data.avatar;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.data.name;
                font-size: 15px;
                font-weight: 600;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
    }
}

// Плейлист дня: 1 предложить, 2 собирается, 3 готов, 4 ждёт статистики.
export component DailyCard inherits Rectangle {
    in property <int> state;
    // Режим продвинутого пользователя: «Собрать сейчас», пока ждёт статистики.
    in property <bool> advanced;
    callback force;
    in property <string> detail;
    in property <[image]> covers;
    callback open;
    callback play;
    callback enable;
    callback dismiss;
    accessible-role: button;
    accessible-label: Tr.w.daily-title;
    accessible-description: root.detail;
    accessible-action-default => { if (root.state == 3) { root.open(); } }
    height: 88px;
    border-radius: Ui.radius-large;
    background: touch.has-hover && root.state == 3 ? Theme.surface : Theme.foreground.transparentize(95%);
    animate background { duration: 120ms; easing: ease-out; }
    property <bool> shown;
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: 200ms; easing: ease-out; }
    init => { self.shown = true; }
    // Пока собирается, обложка мягко «дышит».
    property <bool> breath;
    Timer {
        interval: 900ms;
        running: root.state == 2;
        triggered => { root.breath = !root.breath; }
    }
    touch := TouchArea {
        enabled: root.state == 3;
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: Ui.radius;
            clip: true;
            background: @linear-gradient(135deg, #f7b267 0%, #f4845f 55%, #c8607a 100%);
            opacity: root.state == 2 && root.breath ? 0.55 : 1;
            animate opacity { duration: 900ms; easing: ease-in-out; }
            if root.covers.length == 0: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 30px;
                icon: Icons.sun;
                tint: white;
            }
            if root.covers.length > 0 && root.covers.length < 4: CrossImage {
                width: 100%;
                height: 100%;
                source: root.covers[0];
            }
            if root.covers.length >= 4: Rectangle {
                for cover[index] in root.covers: CrossImage {
                    x: Math.mod(index, 2) * 32px;
                    y: Math.floor(index / 2) * 32px;
                    width: 32px;
                    height: 32px;
                    source: cover;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.state == 1 ? Tr.w.daily-offer : Tr.w.daily-title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                wrap: word-wrap;
            }
        }
        if root.state == 3: VerticalLayout {
            alignment: center;
            MediaButton {
                kind: 0;
                primary: true;
                label: Tr.w.play;
                clicked => { root.play(); }
            }
        }
        if root.state == 4 && root.advanced: VerticalLayout {
            alignment: center;
            Button {
                text: Tr.w.daily-force;
                clicked => { root.force(); }
            }
        }
        if root.state == 1: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Button {
                    text: Tr.w.daily-later;
                    clicked => { root.dismiss(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: Tr.w.daily-enable;
                    primary: true;
                    clicked => { root.enable(); }
                }
            }
        }
    }
}

// Образец темы в настройках: маленькое окно в её цветах и имя.
export component ThemeSwatch inherits Rectangle {
    in property <ThemeCard> data;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.data.name;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    // В узком окне образцы мельчают, чтобы влезали четыре в ряд.
    in property <length> side: 104px;
    width: root.side;
    height: self.picture + 28px;
    property <length> picture: 24px + root.side * 0.35;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: root.picture;
            border-radius: Ui.radius-large;
            // Сплошной цвет: градиент со скруглением программная отрисовка не умеет.
            background: root.data.cover ? #6a3a80 : root.data.background;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Theme.accent : Theme.border;
            clip: true;
            Rectangle {
                x: 6px;
                y: 6px;
                width: 14px;
                height: parent.height - 12px;
                border-radius: Ui.radius-small;
                background: root.data.surface;
                opacity: root.data.cover ? 0.35 : 1;
            }
            Rectangle {
                x: 26px;
                y: 12px;
                width: min(44px, parent.width - 34px);
                height: 5px;
                border-radius: 2.5px;
                background: root.data.foreground;
                opacity: 0.85;
            }
            Rectangle {
                x: 26px;
                y: 22px;
                width: min(30px, parent.width - 34px);
                height: 4px;
                border-radius: 2px;
                background: root.data.foreground;
                opacity: 0.45;
            }
            Rectangle {
                x: parent.width - 22px;
                y: parent.height - 22px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.data.system-accent ? Palette.accent-background : root.data.accent;
            }
        }
        Text {
            text: root.data.name;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: Theme.foreground;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Плитка исполнителя: круглый аватар, догружается, когда плитка видна.
export component ArtistTile inherits Rectangle {
    in property <ArtistRow> data;
    in property <length> side;
    callback clicked;
    callback shown;
    accessible-role: button;
    accessible-label: root.data.name;
    accessible-description: root.data.detail;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius-large;
    background: touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    // Плитка близко к видимой части сетки — пора догрузить картинку.
    in property <bool> near;
    init => {
        if (root.near) {
            root.shown();
        }
    }
    changed near => {
        if (root.near) {
            root.shown();
        }
    }
    // Список перечитали (после сканирования) — картинку запросить снова.
    changed data => {
        if (root.near) {
            root.shown();
        }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Cover {
                width: root.side;
                height: root.side;
                border-radius: root.side / 2;
                letter: root.data.letter;
                source: root.data.avatar;
            }
        }
        // Подписи шириной с картинку, а не с плитку — меньше перераскладки, пока тянут окно.
        HorizontalLayout {
            alignment: center;
            Text {
                width: min(root.side + 16px, root.width - 20px);
                text: root.data.name;
                font-size: 15px;
                font-weight: 600;
                color: Theme.foreground;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: min(root.side + 16px, root.width - 20px);
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Плитка альбома в сетке: обложка, название (до двух строк) и год.
export component AlbumTile inherits Rectangle {
    in property <AlbumRow> data;
    in property <length> side;
    callback clicked;
    accessible-role: button;
    accessible-label: root.data.title;
    accessible-description: root.data.detail;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius-large;
    background: touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Cover {
                width: root.side;
                height: root.side;
                source: root.data.cover;
            }
        }
        // Подписи — шириной с обложку и под ней (см. `ArtistTile`).
        HorizontalLayout {
            alignment: center;
            Text {
                width: root.side;
                text: root.data.title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.foreground;
                wrap: word-wrap;
                overflow: elide;
                height: 38px;
                vertical-alignment: top;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: root.side;
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Сетки исполнителей и альбомов. У плитки своё место (колонка, строка); колонок стало
// больше или меньше — плитка переезжает. Невидимые не рисуются.
export component ArtistGrid inherits ScrollView {
    in property <[ArtistRow]> rows;
    callback open(int);
    callback shown(int);
    property <int> columns: max(2, floor((self.width - 24px) / 176px));
    property <length> cell: (self.width - 24px) / self.columns;
    property <length> side: min(150px, self.cell - 28px);
    property <length> line: self.side + 74px;
    content-width: self.width;
    content-height: Math.ceil(self.rows.length / self.columns) * self.line;
    for data[index] in root.rows: ArtistTile {
        property <float> place-column: Math.mod(index, root.columns);
        property <float> place-row: floor(index / root.columns);
        animate place-column, place-row { duration: 380ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        x: 12px + self.place-column * root.cell;
        y: self.place-row * root.line;
        width: root.cell;
        height: root.line;
        visible: self.y + self.height > -root.content-y && self.y < -root.content-y + root.height;
        near: self.y + self.height > -root.content-y - root.height / 2 && self.y < -root.content-y + root.height * 1.5;
        data: data;
        side: root.side;
        clicked => { root.open(index); }
        shown => { root.shown(index); }
    }
}

export component AlbumGrid inherits ScrollView {
    in property <[AlbumRow]> rows;
    callback open(int);
    property <int> columns: max(2, floor((self.width - 24px) / 186px));
    property <length> cell: (self.width - 24px) / self.columns;
    property <length> side: min(180px, self.cell - 20px);
    property <length> line: self.side + 86px;
    content-width: self.width;
    content-height: Math.ceil(self.rows.length / self.columns) * self.line;
    for data[index] in root.rows: AlbumTile {
        property <float> place-column: Math.mod(index, root.columns);
        property <float> place-row: floor(index / root.columns);
        animate place-column, place-row { duration: 380ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        x: 12px + self.place-column * root.cell;
        y: self.place-row * root.line;
        width: root.cell;
        height: root.line;
        visible: self.y + self.height > -root.content-y && self.y < -root.content-y + root.height;
        data: data;
        side: root.side;
        clicked => { root.open(index); }
    }
}

// Строка меню «⋯» на панели: значок и подпись.
export component MenuRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 36px;
    border-radius: Ui.radius;
    background: touch.has-hover ? Theme.foreground.with-alpha(0.08) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                icon: root.icon;
                tint: root.active ? Theme.accent : Theme.foreground;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AlbumLine inherits Line {
    in property <AlbumRow> data;
    label: root.data.title;
    height: 76px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Cover {
                width: 60px;
                height: 60px;
                source: root.data.cover;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.data.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
    }
}

export component TrackLine inherits Line {
    in property <TrackRow> data;
    in property <bool> removable;
    callback like;
    callback add;
    callback info;
    callback remove;
    callback badge;
    label: root.data.title;
    height: 44px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            width: 36px;
            text: root.data.playing ? "►" : root.data.number;
            font-size: 13px;
            color: root.data.playing ? Theme.accent : Theme.foreground;
            opacity: root.data.playing ? 1 : 0.6;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.data.title;
                font-size: 14px;
                font-weight: root.data.playing ? 700 : 400;
                color: root.data.playing ? Theme.accent : Theme.foreground;
                overflow: elide;
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
        if root.data.lyrics: VerticalLayout {
            alignment: center;
            LyricsMark {}
        }
        if root.data.badge != "": VerticalLayout {
            alignment: center;
            Badge {
                text: root.data.badge;
                kind: root.data.badge-kind;
                clickable: root.data.badge-clickable;
                clicked => { root.badge(); }
            }
        }
        Text {
            text: root.data.duration;
            font-size: 13px;
            color: Theme.foreground;
            opacity: 0.6;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    size: 28px;
                    glyph: 16px;
                    icon: Icons.heart;
                    highlight: false;
                    filled: root.data.liked;
                    active: root.data.liked;
                    label: root.data.liked ? Tr.w.unlike : Tr.w.like;
                    clicked => { root.like(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    size: 28px;
                    glyph: 16px;
                    icon: Icons.plus;
                    label: Tr.w.add-menu;
                    clicked => { root.add(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    size: 28px;
                    glyph: 16px;
                    icon: Icons.info;
                    label: Tr.w.track-info;
                    clicked => { root.info(); }
                }
            }
            if root.removable: VerticalLayout {
                alignment: center;
                IconButton {
                    size: 28px;
                    glyph: 16px;
                    icon: Icons.close;
                    label: Tr.w.remove-from-playlist;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

export component QueueLine inherits Line {
    in property <QueueRow> data;
    in property <bool> first;
    in property <bool> last;
    callback up;
    callback down;
    callback remove;
    label: root.data.title;
    height: 44px;
    opacity: root.data.past ? 0.55 : 1;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            width: 36px;
            text: root.data.current ? "►" : root.data.number;
            font-size: 13px;
            color: root.data.current ? Theme.accent : Theme.foreground;
            opacity: root.data.current ? 1 : 0.6;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.data.title;
                font-size: 14px;
                font-weight: root.data.current ? 700 : 400;
                color: root.data.current ? Theme.accent : Theme.foreground;
                overflow: elide;
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
        Text {
            text: root.data.duration;
            font-size: 13px;
            color: Theme.foreground;
            opacity: 0.6;
            vertical-alignment: center;
        }
        Mini {
            text: "▲";
            label: Tr.w.queue-up;
            opacity: root.first ? 0.3 : 1;
            clicked => { if (!root.first) { root.up(); } }
        }
        Mini {
            text: "▼";
            label: Tr.w.queue-down;
            opacity: root.last ? 0.3 : 1;
            clicked => { if (!root.last) { root.down(); } }
        }
        Mini {
            text: "×";
            label: Tr.w.queue-remove;
            clicked => { root.remove(); }
        }
    }
}

// Строка синхронного текста: текущая крупнеет, колонка едет к ней. Нажатие — перемотка.
export component LyricLine inherits Text {
    callback centered(length);
    callback clicked();
    in property <bool> current;
    in property <length> small-size: 15px;
    in property <length> big-size: 20px;
    in property <color> tint: Theme.foreground;
    in property <color> highlight: Theme.accent;
    wrap: word-wrap;
    // Жирность не анимируется — выделяем размером и цветом.
    font-size: root.current ? root.big-size : root.small-size;
    font-weight: 600;
    color: root.current ? root.highlight : root.tint;
    opacity: root.current || touch.has-hover ? 1 : 0.55;
    animate font-size, color, opacity { duration: 300ms; easing: ease-out; }
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    init => {
        if (root.current) {
            root.centered(root.y + root.height / 2);
        }
    }
    changed current => {
        if (root.current) {
            root.centered(root.y + root.height / 2);
        }
    }
    changed y => {
        if (root.current) {
            root.centered(root.y + root.height / 2);
        }
    }
    changed height => {
        if (root.current) {
            root.centered(root.y + root.height / 2);
        }
    }
}

// Весь текст колонкой, текущая посередине.
export component LyricsScroll inherits Rectangle {
    in property <[LyricRow]> lines;
    in property <length> small-size: 15px;
    in property <length> big-size: 20px;
    in property <color> tint: Theme.foreground;
    in property <color> highlight: Theme.accent;
    in property <TextHorizontalAlignment> align: center;
    // Нажали на строку с этим номером.
    callback line-clicked(int);
    // Середина текущей строки внутри колонки.
    property <length> focus-y;
    clip: true;
    column := VerticalLayout {
        y: root.height / 2 - root.focus-y;
        width: root.width;
        height: self.preferred-height;
        spacing: 10px;
        animate y { duration: 400ms; easing: ease-in-out; }
        for line[index] in root.lines: LyricLine {
            text: line.text;
            current: line.current;
            small-size: root.small-size;
            big-size: root.big-size;
            tint: root.tint;
            highlight: root.highlight;
            horizontal-alignment: root.align;
            centered(center) => { root.focus-y = center; }
            clicked => { root.line-clicked(index); }
        }
    }
}

// Сцены: кадр рисует Rust (Slint не умеет поворачивать), окно его показывает.
export component StageLyrics inherits Rectangle {
    in property <image> frame;
    // 0 — окно текста, 1 — полноэкранный плеер.
    in property <int> place;
    callback resized(int, length, length);
    init => {
        root.resized(root.place, root.width, root.height);
    }
    changed width => {
        root.resized(root.place, root.width, root.height);
    }
    changed height => {
        root.resized(root.place, root.width, root.height);
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.frame;
        image-fit: fill;
    }
}

// Текст-ссылка: при наведении — цветом акцента, нажатие ведёт куда-то.
export component Link inherits Rectangle {
    callback clicked;
    in property <string> text;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <float> rest-opacity: 0.7;
    in property <TextHorizontalAlignment> align: left;
    // Цвет без наведения: в полноэкранном плеере фон всегда тёмный.
    in property <color> tint: Theme.foreground;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    min-width: 0;
    preferred-width: label.preferred-width;
    height: label.preferred-height;
    label := Text {
        width: 100%;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: root.align;
        color: area.has-hover ? Theme.accent : root.tint;
        opacity: area.has-hover ? 1 : root.rest-opacity;
        overflow: elide;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HistoryLine inherits Line {
    in property <HistoryRow> data;
    label: root.data.title;
    height: root.data.day != "" ? 76px : 44px;
    VerticalLayout {
        if root.data.day != "": Text {
            height: 32px;
            x: 16px;
            text: root.data.day;
            font-size: 13px;
            font-weight: 700;
            color: Theme.foreground;
            opacity: 0.7;
            vertical-alignment: bottom;
        }
        HorizontalLayout {
            height: 44px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            Text {
                width: 44px;
                text: root.data.time;
                font-size: 13px;
                color: Theme.foreground;
                opacity: 0.6;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.data.title;
                    font-size: 14px;
                    color: Theme.foreground;
                    overflow: elide;
                }
                if root.data.detail != "": Text {
                    text: root.data.detail;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.6;
                    overflow: elide;
                }
            }
            Text {
                text: root.data.duration;
                font-size: 13px;
                color: Theme.foreground;
                opacity: 0.6;
                vertical-alignment: center;
            }
        }
    }
}

export component Heading inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: Theme.foreground;
    opacity: 0.7;
}

export component Tab inherits Rectangle {
    callback clicked;
    in property <string> text;
    in property <bool> selected;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 32px;
    width: label.preferred-width + 20px;
    border-radius: Ui.radius;
    background: root.selected ? Theme.surface : area.has-hover ? Theme.surface.transparentize(50%) : transparent;
    animate background { duration: 140ms; }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: root.selected ? 700 : 400;
        color: Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Полоса перемотки формой волны: сыгранное — цветом акцента, клик перематывает.
export component WaveBar inherits Rectangle {
    in property <image> wave;
    in property <float> position;
    in property <float> duration;
    callback seek(float);
    min-width: 120px;
    height: 30px;
    accessible-role: slider;
    accessible-label: Tr.w.seek;
    accessible-value: round(root.position) + "";
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;
    accessible-value-step: 5;
    accessible-action-increment => { root.seek(min(root.position + 5, root.duration)); }
    accessible-action-decrement => { root.seek(max(root.position - 5, 0)); }
    accessible-action-set-value(value) => { root.seek(clamp(value.to-float(), 0, root.duration)); }
    Image {
        width: parent.width;
        height: parent.height;
        source: root.wave;
        image-fit: fill;
        colorize: Theme.foreground.transparentize(55%);
    }
    Rectangle {
        x: 0;
        width: root.duration > 0 ? root.width * clamp(root.position / root.duration, 0, 1) : 0;
        height: parent.height;
        clip: true;
        Image {
            x: 0;
            width: root.width;
            height: root.height;
            source: root.wave;
            image-fit: fill;
            colorize: Theme.accent;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1) * root.duration); }
    }
}

// Небольшая кнопка-переключатель в панели плеера.
export component Chip inherits Rectangle {
    callback clicked;
    in property <string> text;
    // Включено: обводка и подпись цветом акцента.
    in property <bool> active;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 26px;
    width: label.preferred-width + 14px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: area.has-hover ? Theme.surface : Theme.background;
    animate background, border-color { duration: 140ms; }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: 12px;
        color: root.active ? Theme.accent : Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Часы или минуты в меню сна: колесо, перетаскивание, стрелки.
export component TimePart inherits Rectangle {
    in property <string> text;
    in property <string> label;
    callback step(int);
    property <length> dragged;
    width: 76px;
    height: 112px;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-action-increment => { root.step(1); }
    accessible-action-decrement => { root.step(-1); }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            IconButton {
                size: 26px;
                glyph: 16px;
                icon: "M6 15 L12 9 L18 15";
                label: root.label + " +";
                clicked => { root.step(1); }
            }
        }
        Text {
            text: root.text;
            font-size: 40px;
            font-weight: 600;
            color: Theme.foreground;
            horizontal-alignment: center;
            animate color { duration: 120ms; }
        }
        HorizontalLayout {
            alignment: center;
            IconButton {
                size: 26px;
                glyph: 16px;
                icon: Icons.collapse;
                label: root.label + " −";
                clicked => { root.step(-1); }
            }
        }
    }
    TouchArea {
        y: 26px;
        height: parent.height - 52px;
        mouse-cursor: ns-resize;
        scroll-event(event) => {
            root.step(event.delta-y > 0 ? 1 : -1);
            return accept;
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragged = 0px;
            }
        }
        moved => {
            // Каждые 14 точек вверх — +1, вниз — −1.
            if (self.pressed) {
                if (self.pressed-y - self.mouse-y - root.dragged > 14px) {
                    root.dragged += 14px;
                    root.step(1);
                } else if (self.mouse-y - self.pressed-y + root.dragged > 14px) {
                    root.dragged -= 14px;
                    root.step(-1);
                }
            }
        }
    }
}

// Таймер сна: во сколько (сверху) или через сколько (круг, 12 ч на оборот).
export component SleepMenu inherits Rectangle {
    in property <string> hours;
    in property <string> minutes;
    in property <string> day;
    in property <string> left;
    in property <string> arc;
    in property <float> handle-x;
    in property <float> handle-y;
    in property <float> now-x;
    in property <float> now-y;
    in property <bool> running;
    in property <bool> after-track;
    callback step(int, int);
    callback dial(float, float, bool);
    callback wheel(int);
    callback start();
    callback stop();
    callback after-track-toggle();
    callback close();
    property <bool> shown;
    width: 300px;
    height: layout.preferred-height;
    border-radius: Ui.radius-huge;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }
    init => { root.shown = true; }
    // Нажатия внутри меню не закрывают его.
    TouchArea {}
    layout := VerticalLayout {
        padding: 16px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: Tr.w.sleep-title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                size: 28px;
                glyph: 16px;
                icon: Icons.close;
                label: Tr.w.close;
                clicked => { root.close(); }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 2px;
            TimePart {
                text: root.hours;
                label: Tr.w.sleep-hours;
                step(delta) => { root.step(0, delta); }
            }
            Text {
                text: ":";
                font-size: 40px;
                font-weight: 600;
                color: Theme.foreground;
                vertical-alignment: center;
            }
            TimePart {
                text: root.minutes;
                label: Tr.w.sleep-minutes;
                step(delta) => { root.step(1, delta); }
            }
        }
        Text {
            text: root.day;
            font-size: 12px;
            color: Theme.foreground;
            opacity: 0.6;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            dial := Rectangle {
                width: 220px;
                height: 220px;
                // Квадрат 200 × 200 внутри, кольца — радиусы 80 и 64.
                property <float> k: self.width / 200px;
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: "M 180 100 A 80 80 0 1 1 20 100 A 80 80 0 1 1 180 100 Z";
                    stroke: Theme.foreground.transparentize(85%);
                    stroke-width: 12px;
                    fill: transparent;
                }
                // Отметки часов.
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: "M 100 4 V 12 M 148 16.9 L 144 23.8 M 183.1 52 L 176.2 56 M 196 100 H 188 M 183.1 148 L 176.2 144 M 148 183.1 L 144 176.2 M 100 196 V 188 M 52 183.1 L 56 176.2 M 16.9 148 L 23.8 144 M 4 100 H 12 M 16.9 52 L 23.8 56 M 52 16.9 L 56 23.8";
                    stroke: Theme.foreground.transparentize(55%);
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                    fill: transparent;
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: root.arc != "" ? root.arc : "M 100 20";
                    stroke: Theme.accent;
                    stroke-width: 12px;
                    stroke-line-cap: round;
                    fill: transparent;
                }
                // «Сейчас» — маленькая точка, цель — ручка.
                Rectangle {
                    x: root.now-x * parent.k * 1px - self.width / 2;
                    y: root.now-y * parent.k * 1px - self.height / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.foreground;
                }
                Rectangle {
                    x: root.handle-x * parent.k * 1px - self.width / 2;
                    y: root.handle-y * parent.k * 1px - self.height / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: Theme.accent;
                    border-width: 3px;
                    border-color: Theme.surface;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #00000060;
                }
                Text {
                    text: root.left;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.dial((self.mouse-x - self.width / 2) / 1px, (self.mouse-y - self.height / 2) / 1px, true);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.dial((self.mouse-x - self.width / 2) / 1px, (self.mouse-y - self.height / 2) / 1px, false);
                        }
                    }
                    scroll-event(event) => {
                        root.wheel(event.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                }
            }
        }
        // Кнопки поровну во всю ширину (раньше вылезали за край).
        HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            Chip {
                text: Tr.w.sleep-after-track;
                active: root.after-track;
                clicked => { root.after-track-toggle(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 6px;
            if root.running: Button {
                horizontal-stretch: 1;
                text: Tr.w.sleep-stop;
                clicked => { root.stop(); }
            }
            Button {
                horizontal-stretch: 1;
                text: root.running ? Tr.w.sleep-change : Tr.w.sleep-start;
                primary: true;
                clicked => { root.start(); }
            }
        }
    }
}

// Раздел настроек — карточка с заголовком.
export component Section inherits Rectangle {
    in property <string> title;
    border-radius: Ui.radius-large;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border.transparentize(50%);
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: Theme.foreground;
        }
        @children
    }
}

// Тонкая черта между пунктами раздела.
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border.transparentize(40%);
}
