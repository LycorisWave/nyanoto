// Общее для окна компьютера и телефона: типы, переводы и мелкие детали.

import { ListView, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { BendVolume, Button, ComboBox, DragArea, Fold, LineEdit, Slider, Switch, WidgetWords, WindowButtons } from "widgets.slint";
import { Theme } from "theme.slint";
import { SeasonBadge, SeasonDecor, SeasonEpisode } from "season.slint";
// Моноширинный шрифт темы «Терминал» — встроен: одинаков в Linux, Windows и Android.
import "../fonts/JetBrainsMono-Regular.otf";
import "../fonts/JetBrainsMono-Bold.otf";
import { Appear, CrossImage, CrossText, Icons, Icon, IconButton, NavItem, Reveal, SeekBar, Tip, TipLayer, Ui } from "icons.slint";


// Тема в настройках: имя и цвета для образца.
export struct ThemeCard {
    name: string,
    background: color,
    surface: color,
    foreground: color,
    accent: color,
    // Акцент системный (у образца — нынешний системный).
    system-accent: bool,
    // «Обложка» — образец с цветным переливом.
    cover: bool,
}

export struct ArtistRow {
    name: string,
    letter: string,
    detail: string,
    // Аватар, уже круглый; пустой — вместо него буква.
    avatar: image,
}

// Папка музыки: путь и раскладка (0 папки, 1 теги, 2 композиторы).
// Строка своего выбора папки или файла (телефон).
export struct BrowseRow {
    name: string,
    folder: bool,
}

export struct RootRow {
    path: string,
    grouping: int,
}

export struct AlbumRow {
    title: string,
    detail: string,
    cover: image,
}

export struct TrackRow {
    number: string,
    title: string,
    detail: string,
    duration: string,
    playing: bool,
    liked: bool,
    // Значок качества: 0 Hi-Res, 1 «подделка?», 2 выбран руками, 3 Lossy, 4 CD, 5 DSD.
    badge: string,
    badge-kind: int,
    badge-clickable: bool,
    // Есть ли текст песни (.lrc рядом или в тегах).
    lyrics: bool,
}

// Строка очереди: уже сыгранные — бледнее, текущая — цветом акцента.
export struct QueueRow {
    number: string,
    title: string,
    detail: string,
    duration: string,
    current: bool,
    past: bool,
}

export struct InfoRow {
    name: string,
    value: string,
}

export struct TagRow {
    key: string,
    value: string,
}

export struct OptionRow {
    title: string,
    detail: string,
}

// Узел карты прослушиваний: центр и радиус в логических точках холста.
export struct GraphNode {
    x: float,
    y: float,
    r: float,
    color: color,
    label: string,
    artist: bool,
    // Обложка или аватар (уже круглый); нет — цветной узел.
    image: image,
    letter: string,
}

// Строка «О приложении»: компонент, версия, лицензия.
export struct AboutRow {
    name: string,
    version: string,
    license: string,
}

