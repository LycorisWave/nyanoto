// Детали окна телефона: крупнее под палец, без наведения.

import { Theme } from "theme.slint";
import { Icons, Icon, IconButton, Ui } from "icons.slint";
import { TrackRow, ArtistRow, AlbumRow, Cover, Badge, LyricsMark, MediaButton, Tr } from "common.slint";

// Нажатие: строка чуть темнеет, пока палец на ней.
export component Press inherits Rectangle {
    callback clicked;
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: Ui.radius;
    background: touch.pressed ? Theme.surface : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    @children
}

// Трек списком: название, кто и сколько; лайк и «+».
export component PhoneTrack inherits Press {
    in property <TrackRow> data;
    in property <bool> removable;
    callback like;
    callback add;
    callback remove;
    callback badge;
    label: root.data.title;
    height: 58px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 10px;
        if root.data.playing: VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                icon: Icons.play;
                tint: Theme.accent;
                filled: true;
            }
        }
        if !root.data.playing && root.data.number != "": Text {
            width: 26px;
            text: root.data.number;
            font-size: 13px;
            color: Theme.foreground;
            opacity: 0.5;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.data.title;
                font-size: 15px;
                font-weight: root.data.playing ? 700 : 400;
                color: root.data.playing ? Theme.accent : Theme.foreground;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                if root.data.lyrics: VerticalLayout {
                    alignment: center;
                    LyricsMark { glyph: 12px; }
                }
                if root.data.badge != "": VerticalLayout {
                    alignment: center;
                    Badge {
                        text: root.data.badge;
                        kind: root.data.badge-kind;
                        clickable: root.data.badge-clickable;
                        clicked => { root.badge(); }
                    }
                }
                Text {
                    text: root.data.detail == "" ? root.data.duration : root.data.detail + " · " + root.data.duration;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.6;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                size: 40px;
                glyph: 18px;
                icon: Icons.heart;
                highlight: false;
                filled: root.data.liked;
                active: root.data.liked;
                label: root.data.liked ? Tr.w.unlike : Tr.w.like;
                clicked => { root.like(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                size: 40px;
                glyph: 18px;
                icon: root.removable ? Icons.close : Icons.more;
                label: root.removable ? Tr.w.remove-from-playlist : Tr.w.add-menu;
                clicked => {
                    if (root.removable) {
                        root.remove();
                    } else {
                        root.add();
                    }
                }
            }
        }
    }
}

// Исполнитель или плейлист строкой: кружок, имя, сводка.
export component PhoneArtist inherits Press {
    in property <ArtistRow> data;
    label: root.data.name;
    height: 64px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Cover {
                width: 46px;
                height: 46px;
                border-radius: 23px;
                letter: root.data.letter;
                source: root.data.avatar;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.name;
                font-size: 15px;
                color: Theme.foreground;
                overflow: elide;
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
    }
}

// Альбом строкой.
export component PhoneAlbum inherits Press {
    in property <AlbumRow> data;
    label: root.data.title;
    height: 72px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Cover {
                width: 56px;
                height: 56px;
                source: root.data.cover;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.title;
                font-size: 15px;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.data.detail;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.6;
                overflow: elide;
            }
        }
    }
}

// Вкладка внизу: значок и подпись.
export component TabButton inherits Rectangle {
    callback clicked;
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 30px;
                border-radius: 15px;
                background: root.selected ? Theme.accent.transparentize(78%) : transparent;
                animate background { duration: 160ms; easing: ease-out; }
                Icon {
                    width: 22px;
                    height: 22px;
                    icon: root.icon;
                    tint: root.selected ? Theme.accent : Theme.foreground;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.accent : Theme.foreground;
            opacity: root.selected ? 1 : 0.7;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Мини-плеер над вкладками: тап — полный плеер.
export component MiniPlayer inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <float> progress;
    callback open;
    callback toggle;
    callback next;
    height: 64px;
    border-radius: Ui.radius-large;
    background: Theme.surface;
    clip: true;
    accessible-role: button;
    accessible-label: Tr.w.full-player;
    accessible-action-default => { root.open(); }
    TouchArea {
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding: 8px;
        padding-right: 4px;
        spacing: 10px;
        Cover {
            width: 48px;
            height: 48px;
            source: root.cover;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.artist;
                font-size: 12px;
                color: Theme.foreground;
                opacity: 0.65;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            MediaButton {
                kind: root.playing ? 1 : 0;
                width: 44px;
                height: 44px;
                label: root.playing ? Tr.w.pause : Tr.w.play;
                clicked => { root.toggle(); }
            }
        }
        VerticalLayout {
            alignment: center;
            MediaButton {
                kind: 3;
                width: 44px;
                height: 44px;
                label: Tr.w.next-track;
                clicked => { root.next(); }
            }
        }
    }
    // Тонкая полоска прослушанного снизу.
    Rectangle {
        x: 12px;
        y: parent.height - 3px;
        width: parent.width - 24px;
        height: 2px;
        border-radius: 1px;
        background: Theme.foreground.transparentize(85%);
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.progress, 0, 1);
            height: parent.height;
            border-radius: 1px;
            background: Theme.accent;
        }
    }
}

// Окно поверх всего: затемнение и карточка по ширине телефона.
export component Sheet inherits Rectangle {
    // Высота карточки: своя (по содержимому) или почти весь экран.
    in property <bool> tall;
    in property <length> inset-bottom;
    // Жест «Назад»: карточка уходит вниз за пальцем.
    in property <float> peek;
    callback dismiss;
    property <bool> shown;
    opacity: self.shown ? 1 - self.peek * 0.4 : 0;
    animate opacity { duration: 160ms; easing: ease-out; }
    init => { self.shown = true; }
    background: #00000099;
    TouchArea {
        clicked => { root.dismiss(); }
    }
    card := Rectangle {
        width: min(root.width - 24px, 520px);
        height: root.tall ? root.height * 0.82 : min(root.height - 48px, content.preferred-height);
        x: (root.width - self.width) / 2;
        y: root.shown ? root.height - self.height - 12px - root.inset-bottom + root.peek * 140px : root.height;
        animate y { duration: root.peek > 0 ? 0ms : 220ms; easing: ease-out; }
        background: Theme.background;
        border-radius: Ui.radius-huge;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        // Нажатие по карточке не закрывает окно.
        TouchArea {}
        content := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            @children
        }
    }
}

// Заголовок окна поверх.
export component SheetTitle inherits Text {
    font-size: 18px;
    font-weight: 700;
    color: Theme.foreground;
    wrap: word-wrap;
}

// Подпись пункта настроек и пояснение. Высота — по ширине: в раскладках Slint считает
// перенос строк для неизвестной ширины, и строки наезжали на соседей.
export component OptionText inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> dim;
    height: hint-text.y + hint-text.height;
    title-text := Text {
        y: 0;
        width: root.width;
        height: root.title != "" ? self.preferred-height : 0;
        text: root.title;
        font-size: 15px;
        color: Theme.foreground;
        opacity: root.dim ? 0.5 : 1;
        wrap: word-wrap;
    }
    hint-text := Text {
        y: title-text.height + (root.title != "" && root.hint != "" ? 2px : 0px);
        width: root.width;
        height: root.hint != "" ? self.preferred-height : 0;
        text: root.hint;
        font-size: 12px;
        color: Theme.foreground;
        opacity: 0.6;
        wrap: word-wrap;
    }
}
