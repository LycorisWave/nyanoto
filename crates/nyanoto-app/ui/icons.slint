// Значки (линии 24 × 24, как Lucide, без шрифтов), кнопки-значки и выезжающие настройки.
// Слово остаётся подсказкой и подписью для диктора.

import { Theme } from "theme.slint";

// Единые размеры. Скругления 4/8/12/16, вложенные — концентрично (12 с отступом 4 → 8).
// Анимации 120/200/320 мс, выход короче входа, без пружин.
export global Ui {
    out property <length> radius-small: 4px;
    out property <length> radius: 8px;
    out property <length> radius-large: 12px;
    out property <length> radius-huge: 16px;
}

