// Подсказка одна на всё окно: её слой — последним в окне, поверх всего.
export global Tip {
    in-out property <string> text;
    // Точка, к которой привязана подсказка (в координатах окна), и сторона.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> right;
}

// Сам уходит через 4 с: кнопка могла исчезнуть раньше мыши.
export component TipLayer inherits Rectangle {
    property <length> margin: 6px;
    if Tip.text != "": Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
        init => { self.shown = true; }
        property <length> w: label.preferred-width + 14px;
        property <length> h: label.preferred-height + 8px;
        x: Tip.right ? Tip.x : clamp(Tip.x - self.w / 2, parent.margin, parent.width - self.w - parent.margin);
        y: Tip.right ? Tip.y - self.h / 2 : clamp(Tip.y, parent.margin, parent.height - self.h - parent.margin);
        width: self.w;
        height: self.h;
        border-radius: Ui.radius;
        background: #000000d8;
        label := Text {
            text: Tip.text;
            font-size: 12px;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Timer {
            interval: 4s;
            running: true;
            triggered => { Tip.text = ""; }
        }
    }
}

// Значок: линии толщиной 1,8 в квадрате 24 × 24.
export component Icon inherits Path {
    in property <string> icon;
    in property <color> tint: Theme.foreground;
    in property <bool> filled;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.icon;
    stroke: root.tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: root.filled ? root.tint : transparent;
    animate stroke, fill { duration: 160ms; easing: ease-out; }
}

// Кнопка-значок. Размер не меняется никогда: число — в углу, таймер — кольцом.
export component IconButton inherits Rectangle {
    callback clicked;
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    // Подсвечивать фон, когда включено (у сердечка нет: светится только оно).
    in property <bool> highlight: true;
    in property <bool> filled;
    // Число или буква в углу — поверх кнопки, её размер не меняется.
    in property <string> badge;
    // Кольцо вокруг значка (сколько до сна).
    in property <string> ring;
    in property <color> tint: Theme.foreground;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    // Подсказка справа, иначе над кнопкой (у верха окна — под).
    in property <bool> tip-right;
    in property <bool> enabled: true;
    property <bool> hovered: area.has-hover;
    property <bool> tipped;
    property <bool> popping;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    opacity: root.enabled ? 1 : 0.35;
    width: root.size;
    height: root.size;
    border-radius: Ui.radius;
    background: area.pressed ? Theme.surface.darker(15%) : area.has-hover ? Theme.surface : root.active && root.highlight ? Theme.accent.transparentize(82%) : transparent;
    animate background { duration: 140ms; easing: ease-out; }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Tip.text = "";
            root.clicked();
        }
    }
    if root.ring != "": Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.glyph + 8px;
        height: root.glyph + 8px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.ring;
        stroke: Theme.accent;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
    }
    Icon {
        property <length> side: area.pressed ? root.glyph * 0.84 : root.popping ? root.glyph * 1.22 : root.glyph;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: self.side;
        height: self.side;
        animate width, height { duration: 140ms; easing: ease-out; }
        icon: root.icon;
        filled: root.filled;
        tint: root.active ? Theme.accent : root.tint;
        opacity: root.active || area.has-hover ? 1 : 0.8;
        animate opacity { duration: 140ms; }
    }
    if root.badge != "": Rectangle {
        property <bool> shown;
        x: root.width - self.width * 0.8;
        y: -3px;
        height: 15px;
        width: max(15px, badge-text.preferred-width + 7px);
        border-radius: 7.5px;
        background: Theme.accent;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; }
        init => { self.shown = true; }
        badge-text := Text {
            text: root.badge;
            font-size: 9px;
            font-weight: 700;
            color: Theme.accent-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // Вспышка: значок на миг крупнее и обратно.
    Timer {
        interval: 150ms;
        running: root.popping;
        triggered => { root.popping = false; }
    }
    changed active => {
        if (root.active) {
            root.popping = true;
        }
    }
    changed badge => {
        if (root.badge != "") {
            root.popping = true;
        }
    }
    Timer {
        interval: 500ms;
        running: area.has-hover && !root.tipped && root.label != "";
        triggered => {
            root.tipped = true;
            Tip.right = root.tip-right;
            if (root.tip-right) {
                Tip.x = root.absolute-position.x + root.width + 6px;
                Tip.y = root.absolute-position.y + root.height / 2;
            } else {
                Tip.x = root.absolute-position.x + root.width / 2;
                Tip.y = root.absolute-position.y > 40px ? root.absolute-position.y - 30px : root.absolute-position.y + root.height + 6px;
            }
            Tip.text = root.label;
        }
    }
    changed hovered => {
        if (!root.hovered) {
            root.tipped = false;
            if (Tip.text == root.label) {
                Tip.text = "";
            }
        }
    }
}

// Картинка, перетекающая в новую при смене.
export component CrossImage inherits Rectangle {
    in property <image> source;
    in property <ImageFit> fit: cover;
    property <bool> flip: true;
    property <image> first;
    property <image> second;
    init => { root.first = root.source; }
    changed source => {
        if (root.flip) {
            root.second = root.source;
        } else {
            root.first = root.source;
        }
        root.flip = !root.flip;
    }
    // Скрытая картинка не рисуется вовсе (а не прозрачной поверх видимой).
    Image {
        width: 100%;
        height: 100%;
        source: root.first;
        image-fit: root.fit;
        opacity: root.flip ? 1 : 0;
        visible: self.opacity > 0.001;
        animate opacity { duration: 280ms; easing: ease-out; }
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.second;
        image-fit: root.fit;
        opacity: root.flip ? 0 : 1;
        visible: self.opacity > 0.001;
        animate opacity { duration: 280ms; easing: ease-out; }
    }
}

// Надпись, которая при смене плавно перетекает в новую (название трека).
export component CrossText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <color> tint: Theme.foreground;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    property <bool> flip: true;
    property <string> first;
    property <string> second;
    init => { root.first = root.text; }
    changed text => {
        if (root.flip) {
            root.second = root.text;
        } else {
            root.first = root.text;
        }
        root.flip = !root.flip;
    }
    min-height: one.preferred-height;
    preferred-height: one.preferred-height;
    one := Text {
        width: 100%;
        text: root.first;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.tint;
        horizontal-alignment: root.horizontal-alignment;
        overflow: elide;
        opacity: root.flip ? 1 : 0;
        visible: self.opacity > 0.001;
        animate opacity { duration: 240ms; easing: ease-out; }
    }
    Text {
        width: 100%;
        text: root.second;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.tint;
        horizontal-alignment: root.horizontal-alignment;
        overflow: elide;
        opacity: root.flip ? 0 : 1;
        visible: self.opacity > 0.001;
        animate opacity { duration: 240ms; easing: ease-out; }
    }
}

// Раздел в боковой полосе: значок, выбранный — с полоской акцента слева.
export component NavItem inherits Rectangle {
    callback clicked;
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    height: 44px;
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 22px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }
    HorizontalLayout {
        alignment: center;
        IconButton {
            icon: root.icon;
            label: root.label;
            size: 40px;
            glyph: 22px;
            tip-right: true;
            active: root.selected;
            clicked => { root.clicked(); }
        }
    }
}

// Появление из прозрачности и чуть снизу.
export component Appear inherits Rectangle {
    property <bool> shown;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 200ms; easing: ease-out; }
    // Стартуем в первый свободный миг, иначе анимация пропадёт за загрузкой.
    Timer {
        interval: 1ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
    Rectangle {
        y: root.shown ? 0px : 14px;
        width: root.width;
        height: root.height;
        animate y { duration: 260ms; easing: ease-out; }
        @children
    }
}

// Перемотка: при наведении толще, подсветка до курсора и время над ним.
export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <string> label;
    in property <color> track: Theme.foreground.transparentize(82%);
    in property <color> preview: Theme.foreground.transparentize(62%);
    in property <color> fill: Theme.accent;
    callback seek(float);
    callback dragging(bool);
    property <float> span: max(root.duration, 0.001);
    property <float> aim: clamp(area.mouse-x / max(root.width, 1px), 0, 1) * root.span;
    property <bool> hot: area.has-hover || area.pressed;
    property <float> shown-at: area.pressed ? root.aim : root.position;
    property <int> whole: Math.floor(root.aim);
    min-width: 100px;
    height: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: Math.round(root.position) + "";
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;
    accessible-value-step: 5;
    accessible-action-increment => { root.seek(min(root.position + 5, root.duration)); }
    accessible-action-decrement => { root.seek(max(root.position - 5, 0)); }
    accessible-action-set-value(value) => { root.seek(clamp(value.to-float(), 0, root.duration)); }
    bar := Rectangle {
        y: (root.height - self.height) / 2;
        height: root.hot ? 6px : 4px;
        animate height { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: root.track;
        clip: true;
        if root.hot: Rectangle {
            x: 0;
            width: parent.width * root.aim / root.span;
            height: parent.height;
            background: root.preview;
        }
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.shown-at / root.span, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.fill;
        }
    }
    // Ручка — только когда рядом мышь.
    Rectangle {
        width: 12px;
        height: 12px;
        x: root.width * clamp(root.shown-at / root.span, 0, 1) - self.width / 2;
        y: (root.height - self.height) / 2;
        border-radius: 6px;
        background: root.fill;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
    if area.has-hover && root.duration > 0: Rectangle {
        property <length> w: time.preferred-width + 12px;
        x: clamp(area.mouse-x - self.w / 2, -8px, root.width - self.w + 8px);
        y: -26px;
        width: self.w;
        height: 22px;
        border-radius: Ui.radius-small + 2px;
        background: #000000d8;
        time := Text {
            text: Math.floor(root.whole / 60) + ":" + (Math.mod(root.whole, 60) < 10 ? "0" : "") + Math.mod(root.whole, 60);
            font-size: 11px;
            font-weight: 600;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging(true);
            } else if (event.kind == PointerEventKind.up) {
                root.seek(root.aim);
                root.dragging(false);
            }
        }
    }
}

// Зависимые настройки: выключили основную — уезжают.
export component Reveal inherits Rectangle {
    in property <bool> open;
    in property <length> gap: 10px;
    clip: true;
    // Пока закрыто и доехало, детей нет и для диктора, и для Tab.
    visible: root.open || self.height > 0.5px;
    height: root.open ? inner.preferred-height + root.gap : 0px;
    opacity: root.open ? 1 : 0;
    animate height { duration: 220ms; easing: ease-out; }
    animate opacity { duration: 220ms; easing: ease-out; }
    inner := VerticalLayout {
        y: root.gap;
        width: root.width;
        height: self.preferred-height;
        spacing: 10px;
        @children
    }
}
