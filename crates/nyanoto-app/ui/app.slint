                                            }
                                        }
                                        Section {
                                            title: Tr.w.section-lyrics;
                                            VerticalLayout {
                                                spacing: 0px;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    Switch {
                                                        accessible-label: Tr.w.lyrics;
                                                        checked <=> root.lyrics-enabled;
                                                        toggled => { root.lyrics-changed(root.lyrics-enabled); }
                                                    }
                                                    VerticalLayout {
                                                        Text {
                                                            text: Tr.w.lyrics;
                                                            color: Theme.foreground;
                                                        }
                                                        Text {
                                                            text: Tr.w.lyrics-hint;
                                                            wrap: word-wrap;
                                                            font-size: 12px;
                                                            color: Theme.foreground;
                                                            opacity: 0.6;
                                                        }
                                                    }
                                                }
                                                Reveal {
                                                    open: root.lyrics-enabled;
                                                    // Строка подсвечивается чуть раньше — глаз успевает прочитать.
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        padding-left: 52px;
                                                        Text {
                                                            text: Tr.w.lyrics-lead + " " + round(root.lyrics-lead) + " " + Tr.w.ms;
                                                            // Узкое окно — подпись сжимается и переносится.
                                                            min-width: root.label-long;
                                                            wrap: word-wrap;
                                                            vertical-alignment: center;
                                                            color: Theme.foreground;
                                                        }
                                                        Slider {
                                                            min-width: 140px;
                                                            preferred-width: 260px;
                                                            accessible-label: Tr.w.lyrics-lead;
                                                            minimum: 0;
                                                            maximum: 1000;
                                                            step: 10;
                                                            value <=> root.lyrics-lead;
                                                            changed(value) => { root.lyrics-lead-changed(value, false); }
                                                            released(value) => { root.lyrics-lead-changed(value, true); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        padding-left: 52px;
                                                        Text {
                                                            text: Tr.w.lyrics-style;
                                                            // Узкое окно — подпись сжимается и переносится.
                                                            min-width: root.label-long;
                                                            wrap: word-wrap;
                                                            vertical-alignment: center;
                                                            color: Theme.foreground;
                                                        }
                                                        ComboBox {
                                                            min-width: 140px;
                                                            preferred-width: 260px;
                                                            model: [Tr.w.style-column, Tr.w.style-scenes];
                                                            current-index <=> root.lyrics-style-index;
                                                            selected(value) => { root.lyrics-style-changed(root.lyrics-style-index); }
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 0px;
                                                        HorizontalLayout {
                                                            padding-left: 52px;
                                                            Text {
                                                                text: Tr.w.lyrics-style-hint;
                                                                wrap: word-wrap;
                                                                font-size: 12px;
                                                                color: Theme.foreground;
                                                                opacity: 0.6;
                                                            }
                                                        }
                                                        Reveal {
                                                            open: root.lyrics-style-index == 1;
                                                            HorizontalLayout {
                                                                spacing: 10px;
                                                                padding-left: 52px;
                                                                Text {
                                                                    text: Tr.w.stage-scene;
                                                                    // Узкое окно — подпись сжимается и переносится.
                                                                    min-width: root.label-long;
                                                                    wrap: word-wrap;
                                                                    vertical-alignment: center;
                                                                    color: Theme.foreground;
                                                                }
                                                                ComboBox {
                                                                    min-width: 140px;
                                                                    preferred-width: 300px;
                                                                    model: root.stage-scene-names;
                                                                    current-index <=> root.stage-scene-index;
                                                                    selected(value) => { root.stage-scene-changed(root.stage-scene-index); }
                                                                }
                                                            }
                                                            HorizontalLayout {
                                                                padding-left: 52px;
                                                                Text {
                                                                    text: Tr.w.stage-scene-hint;
                                                                    wrap: word-wrap;
                                                                    font-size: 12px;
                                                                    color: Theme.foreground;
                                                                    opacity: 0.6;
                                                                }
                                                            }
                                                            HorizontalLayout {
                                                                spacing: 10px;
                                                                padding-left: 52px;
                                                                Text {
                                                                    text: Tr.w.stage-fps;
                                                                    // Узкое окно — подпись сжимается и переносится.
                                                                    min-width: root.label-long;
                                                                    wrap: word-wrap;
                                                                    vertical-alignment: center;
                                                                    color: Theme.foreground;
                                                                }
                                                                ComboBox {
                                                                    min-width: 140px;
                                                                    preferred-width: 260px;
                                                                    model: root.stage-fps-names;
                                                                    current-index <=> root.stage-fps-index;
                                                                    selected(value) => { root.stage-fps-changed(root.stage-fps-index); }
                                                                }
                                                            }
                                                            HorizontalLayout {
                                                                spacing: 12px;
                                                                padding-left: 52px;
                                                                Switch {
                                                                    checked <=> root.stage-fallback-load;
                                                                    accessible-label: Tr.w.stage-fallback-load;
                                                                    toggled => { root.stage-fallback-load-changed(root.stage-fallback-load); }
                                                                }
                                                                VerticalLayout {
                                                                    Text {
                                                                        text: Tr.w.stage-fallback-load;
                                                                        color: Theme.foreground;
                                                                    }
                                                                    Text {
                                                                        text: Tr.w.stage-fallback-load-hint;
                                                                        wrap: word-wrap;
                                                                        font-size: 12px;
                                                                        color: Theme.foreground;
                                                                        opacity: 0.6;
                                                                    }
                                                                }
                                                            }
                                                            HorizontalLayout {
                                                                spacing: 12px;
                                                                padding-left: 52px;
                                                                Switch {
                                                                    checked <=> root.stage-fallback-power;
                                                                    accessible-label: Tr.w.stage-fallback-power;
                                                                    toggled => { root.stage-fallback-power-changed(root.stage-fallback-power); }
                                                                }
                                                                VerticalLayout {
                                                                    Text {
                                                                        text: Tr.w.stage-fallback-power;
                                                                        color: Theme.foreground;
                                                                    }
                                                                    Text {
                                                                        text: Tr.w.stage-fallback-power-hint;
                                                                        wrap: word-wrap;
                                                                        font-size: 12px;
                                                                        color: Theme.foreground;
                                                                        opacity: 0.6;
                                                                    }
                                                                }
                                                            }
                                                            if root.stage-fallback != "": HorizontalLayout {
                                                                padding-left: 52px;
                                                                Text {
                                                                    text: root.stage-fallback;
                                                                    wrap: word-wrap;
                                                                    font-size: 12px;
                                                                    color: Theme.accent;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        Section {
                                            title: Tr.w.section-stats;
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Switch {
                                                    checked <=> root.statistics;
                                                    accessible-label: Tr.w.stats-mode;
                                                    toggled => { root.statistics-changed(root.statistics); }
                                                }
                                                VerticalLayout {
                                                    Text {
                                                        text: Tr.w.stats-mode;
                                                        color: Theme.foreground;
                                                    }
                                                    Text {
                                                        text: Tr.w.stats-hint;
                                                        wrap: word-wrap;
                                                        font-size: 12px;
                                                        color: Theme.foreground;
                                                        opacity: 0.6;
                                                    }
                                                }
                                            }
                                            Divider {}
                                            VerticalLayout {
                                                spacing: 0px;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    Switch {
                                                        accessible-label: Tr.w.link;
                                                        checked <=> root.sync-enabled;
                                                        enabled: false;
                                                        toggled => { root.sync-enabled-changed(self.checked); }
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;
                                                            Text {
                                                                text: Tr.w.link;
                                                                color: Theme.foreground;
                                                                opacity: 0.6;
                                                            }
                                                            VerticalLayout {
                                                                alignment: center;
                                                                DevBadge {}
                                                            }
                                                        }
                                                        Text {
                                                            text: Tr.w.link-hint;
                                                            wrap: word-wrap;
                                                            font-size: 12px;
                                                            color: Theme.foreground;
                                                            opacity: 0.6;
                                                        }
                                                    }
                                                }
                                                Reveal {
                                                    open: root.sync-enabled;
                                                    HorizontalLayout {
                                                        padding-left: 52px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: root.sync-folder;
                                                            horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                            color: Theme.foreground;
                                                        }
                                                        Button {
                                                            text: Tr.w.link-choose;
                                                            clicked => { root.sync-choose(); }
                                                        }
                                                        Button {
                                                            text: Tr.w.link-now;
                                                            clicked => { root.sync-now(); }
                                                        }
                                                    }
                                                    if root.sync-status != "": Text {
                                                        x: 52px;
                                                        text: root.sync-status;
                                                        wrap: word-wrap;
                                                        font-size: 12px;
                                                        color: Theme.foreground;
                                                        opacity: 0.7;
                                                    }
                                                }
                                            }
                                        }
                                        Section {
                                            title: Tr.w.daily-title;
                                            VerticalLayout {
                                                spacing: 0px;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    Switch {
                                                        accessible-label: Tr.w.daily-title;
                                                        enabled: root.daily-available;
                                                        checked <=> root.daily-enabled;
                                                        toggled => { root.daily-enabled-changed(self.checked); }
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: Tr.w.daily-switch;
                                                            color: Theme.foreground;
                                                            opacity: root.daily-available ? 1 : 0.6;
                                                        }
                                                        Text {
                                                            text: Tr.w.daily-hint;
                                                            wrap: word-wrap;
                                                            font-size: 12px;
                                                            color: Theme.foreground;
                                                            opacity: 0.6;
                                                        }
                                                        if root.daily-status != "": Text {
                                                            text: root.daily-status;
                                                            wrap: word-wrap;
                                                            font-size: 12px;
                                                            color: Theme.foreground;
                                                            opacity: 0.8;
                                                        }
                                                        // Режим продвинутого пользователя: собрать без порогов.
                                                        if root.advanced: HorizontalLayout {
                                                            padding-top: 6px;
                                                            spacing: 10px;
                                                            alignment: start;
                                                            Button {
                                                                text: Tr.w.daily-force;
                                                                enabled: root.daily-state != 2;
                                                                clicked => { root.daily-force(); }
                                                            }
                                                            Text {
                                                                text: Tr.w.daily-force-hint;
                                                                wrap: word-wrap;
                                                                font-size: 12px;
                                                                color: Theme.foreground;
                                                                opacity: 0.6;
                                                                vertical-alignment: center;
                                                                horizontal-stretch: 1;
                                                            }
                                                        }
                                                    }
                                                }
                                                Reveal {
                                                    open: root.daily-enabled;
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        padding-left: root.narrow-window ? 0px : 52px;
                                                        alignment: start;
                                                        Text {
                                                            text: Tr.w.daily-length;
                                                            // Узкое окно — подпись сжимается и переносится.
                                                            min-width: root.label-short;
                                                            wrap: word-wrap;
                                                            vertical-alignment: center;
                                                            color: Theme.foreground;
                                                        }
                                                        ComboBox {
                                                            width: 140px;
                                                            model: ["15 " + Tr.w.daily-tracks, "25 " + Tr.w.daily-tracks, "40 " + Tr.w.daily-tracks, "60 " + Tr.w.daily-tracks];
                                                            current-index <=> root.daily-length-index;
                                                            selected(value) => { root.daily-length-changed(root.daily-length-index); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 10px;
                                                        padding-left: 52px;
                                                        Text {
                                                            text: Tr.w.daily-fresh + " — " + round(root.daily-fresh) + " %";
                                                            // Узкое окно — подпись сжимается и переносится.
                                                            min-width: root.label-short;
                                                            wrap: word-wrap;
                                                            vertical-alignment: center;
                                                            color: Theme.foreground;
                                                        }
                                                        Slider {
                                                            min-width: 140px;
                                                            preferred-width: 260px;
                                                            accessible-label: Tr.w.daily-fresh;
                                                            minimum: 0;
                                                            maximum: 60;
                                                            step: 5;
                                                            value <=> root.daily-fresh;
                                                            changed(value) => { root.daily-fresh-changed(value, false); }
                                                            released(value) => { root.daily-fresh-changed(value, true); }
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    padding-left: root.narrow-window ? 0px : 52px;
                                                    alignment: start;
                                                    Text {
                                                        text: Tr.w.daily-threshold;
                                                        // Узкое окно — подпись сжимается и переносится.
                                                        min-width: root.label-short;
                                                        wrap: word-wrap;
                                                        vertical-alignment: center;
                                                        color: Theme.foreground;
                                                    }
                                                    ComboBox {
                                                        width: 220px;
                                                        model: [Tr.w.daily-threshold-early, Tr.w.daily-threshold-usual, Tr.w.daily-threshold-strict];
                                                        current-index <=> root.daily-threshold-index;
                                                        selected(value) => { root.daily-threshold-changed(root.daily-threshold-index); }
                                                    }
                                                }
                                            }
                                        }
                                        if root.future-options.length > 0: Section {
                                            title: Tr.w.in-development;
                                            for option in root.future-options: HorizontalLayout {
                                                spacing: 12px;
                                                Switch {
                                                    enabled: false;
                                                }
                                                VerticalLayout {
                                                    Text {
                                                        text: option.title;
                                                        color: Theme.foreground;
                                                        opacity: 0.6;
                                                    }
                                                    Text {
                                                        text: option.detail;
                                                        wrap: word-wrap;
                                                        font-size: 12px;
                                                        color: Theme.foreground;
                                                        opacity: 0.45;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // Текст песни справа, ~40 % ширины; в узком окне — на всё место.
                // Пока уезжает — ещё есть; `lyrics-keep` читаем и закрытым, иначе анимации не с чего начаться.
                if root.lyrics-open || root.lyrics-keep > 0.005: Rectangle {
                    // Узкое окно — на всё место, иначе 40 %, переход плавный.
                    horizontal-stretch: 0;
                    min-width: 0px;
                    preferred-width: (root.lyrics-width + (root.pages-room - root.lyrics-width) * root.lyrics-grow) * root.lyrics-keep;
                    max-width: self.preferred-width;
                    visible: root.lyrics-keep > 0.01;
                    clip: true;
                    background: Theme.panel;
                    property <bool> shown;
                    opacity: self.shown ? 1 : 0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                    init => { self.shown = true; }
                    // Содержимое сразу во всю ширину и у правого края — строки не переносятся, пока выезжает.
                    Rectangle {
                        width: root.lyrics-width + (root.pages-room - root.lyrics-width) * root.lyrics-grow;
                        x: parent.width - self.width;
                        height: parent.height;
                        Rectangle {
                            x: 0;
                            width: 1px;
                            background: Theme.border;
                        }
                        VerticalLayout {
                            padding: 16px;
                            padding-top: 10px;
                            spacing: 10px;
                            // Верхняя строка — тоже заголовок окна.
                            Rectangle {
                                height: 36px;
                                DragArea {
                                    drag => { root.window-drag(); }
                                    toggle => { root.window-maximize(); }
                                    menu(x, y) => { root.window-menu(x, y); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-right: root.window-buttons-room - 16px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.lyrics-title;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: Theme.foreground;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if root.advanced && root.has-track: VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: Icons.edit;
                                            label: Tr.w.edit-lyrics;
                                            clicked => { root.lyrics-edit(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: Icons.close;
                                            label: Tr.w.close;
                                            clicked => { root.lyrics-close(); }
                                        }
                                    }
                                }
                            }
                            if root.lyrics-synced && root.lyrics-look == 0: LyricsScroll {
                                vertical-stretch: 1;
                                lines: root.lyrics-lines;
                                line-clicked(index) => { root.lyrics-seek(index); }
                            }
                            if root.lyrics-synced && root.lyrics-look == 1: StageLyrics {
                                vertical-stretch: 1;
                                place: 0;
                                frame: root.stage-frame;
                                resized(place, width, height) => { root.stage-resized(place, width, height); }
                            }
                            if !root.lyrics-synced: ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    Text {
                                        text: root.lyrics-plain;
                                        wrap: word-wrap;
                                        color: Theme.foreground;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.status != "": HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                height: 20px;
                Text {
                    text: root.status;
                    font-size: 11px;
                    color: Theme.foreground;
                    opacity: 0.6;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.scan-progress >= 0: Rectangle {
                    width: 160px;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Theme.foreground.transparentize(85%);
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.scan-progress, 0, 1);
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }

            // Панель: трек | управление и перемотка | инструменты и громкость.
            // Крайние колонки равной ширины — середина всегда по центру.
            Rectangle {
                visible: !root.full-covers;
                height: 92px;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    // Трек.
                    bar-track := HorizontalLayout {
                        // Ширина от окна; не влезает — сворачиваются подписи, потом кнопка сведений.
                        min-width: 106px;
                        preferred-width: root.bar-left;
                        max-width: root.bar-left;
                        horizontal-stretch: 0;
                        alignment: start;
                        spacing: 0px;
                        bar-cover := Cover {
                            width: 64px;
                            height: 64px;
                            source: root.now-cover;
                            accessible-role: button;
                            accessible-label: Tr.w.full-player;
                            accessible-action-default => { root.full-toggle(); }
                            TouchArea {
                                mouse-cursor: root.has-track ? MouseCursor.pointer : MouseCursor.default;
                                // Навели на обложку — заранее готовим полный плеер.
                                changed has-hover => {
                                    if (self.has-hover && root.has-track) {
                                        root.full-warmup();
                                    }
                                }
                                clicked => {
                                    if (root.has-track) {
                                        root.full-toggle();
                                    }
                                }
                            }
                        }
                        Rectangle {
                            property <float> share: root.bar-left >= 200px ? 1 : 0;
                            animate share { duration: 260ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                            width: max(0px, root.bar-left - 106px - info-fold.width) * self.share;
                            opacity: self.share;
                            visible: self.share > 0.01;
                            clip: true;
                            VerticalLayout {
                                padding-left: 12px;
                                alignment: center;
                                spacing: 2px;
                                CrossText {
                                    text: root.now-title;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    Link {
                                        text: root.now-owner;
                                        clicked => { root.open-now-artist(); }
                                    }
                                    if root.now-album != "": Text {
                                        text: " · ";
                                        font-size: 12px;
                                        color: Theme.foreground;
                                        opacity: 0.7;
                                    }
                                    if root.now-album != "": Link {
                                        text: root.now-album;
                                        horizontal-stretch: 1;
                                        clicked => { root.open-now-album(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if root.now-lyrics: VerticalLayout {
                                        alignment: center;
                                        LyricsMark { glyph: 14px; }
                                    }
                                    if root.now-badge != "": VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: root.now-badge;
                                            kind: root.now-badge-kind;
                                            clickable: root.now-badge-clickable;
                                            clicked => { root.badge-current(); }
                                        }
                                    }
                                    Text {
                                        text: root.now-quality;
                                        font-size: 11px;
                                        color: Theme.foreground;
                                        opacity: 0.7;
                                        overflow: elide;
                                    }
                                }
                                if root.signal-path != "": Text {
                                    text: root.signal-path;
                                    font-size: 10px;
                                    color: Theme.foreground;
                                    opacity: 0.6;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 12px;
                            HorizontalLayout {
                                visible: root.has-track;
                                IconButton {
                                    size: 30px;
                                    glyph: 18px;
                                    icon: Icons.heart;
                                    highlight: false;
                                    filled: root.now-liked;
                                    active: root.now-liked;
                                    label: root.now-liked ? Tr.w.unlike : Tr.w.like;
                                    clicked => { root.like-current(); }
                                }
                                info-fold := Fold {
                                    open: root.bar-left >= 136px;
                                    size: 30px;
                                    height: 30px;
                                    IconButton {
                                        size: 30px;
                                        glyph: 18px;
                                        icon: Icons.info;
                                        label: Tr.w.track-info;
                                        clicked => { root.info-current(); }
                                    }
                                }
                            }
                        }
                    }
                    // Середина: управление и полоса.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 226px;
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.shuffle;
                                    label: root.shuffle-text;
                                    badge: root.shuffle-mode == 2 ? "А" : "";
                                    active: root.shuffle-on;
                                    clicked => { root.shuffle-cycle(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MediaButton {
                                    kind: 2;
                                    label: Tr.w.previous-track;
                                    clicked => { root.previous(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MediaButton {
                                    kind: root.playing ? 1 : 0;
                                    primary: true;
                                    label: root.playing ? Tr.w.pause : Tr.w.play;
                                    clicked => { root.toggle(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MediaButton {
                                    kind: 3;
                                    label: Tr.w.next-track;
                                    clicked => { root.next(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: root.repeat-mode == 1 ? Icons.repeat-one : Icons.repeat;
                                    label: root.repeat-text;
                                    active: root.repeat-on;
                                    clicked => { root.cycle-repeat(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.position-text;
                                width: 44px;
                                font-size: 12px;
                                color: Theme.foreground;
                                opacity: 0.8;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            if root.wavebar-enabled && root.wavebar-ready: WaveBar {
                                horizontal-stretch: 1;
                                wave: root.wavebar;
                                position: root.position;
                                duration: root.duration;
                                seek(seconds) => { root.seek(seconds); }
                            }
                            if !(root.wavebar-enabled && root.wavebar-ready): SeekBar {
                                horizontal-stretch: 1;
                                label: Tr.w.seek;
                                position: root.position;
                                duration: root.duration;
                                dragging(on) => { root.seeking = on; }
                                seek(seconds) => {
                                    root.position = seconds;
                                    root.seek(seconds);
                                }
                            }
                            Text {
                                text: root.duration-text;
                                width: 44px;
                                font-size: 12px;
                                color: Theme.foreground;
                                opacity: 0.8;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Инструменты и громкость: не влезает — значки по одному уходят в «⋯»,
                    // скорость — раньше, чем начнёт гнуться громкость.
                    VerticalLayout {
                        min-width: 38px;
                        preferred-width: root.bar-right;
                        max-width: root.bar-right;
                        horizontal-stretch: 0;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            spacing: 0px;
                            if root.lyrics-enabled: Fold {
                                open: root.tool-lyrics;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.lyrics;
                                    label: Tr.w.lyrics-button;
                                    active: root.lyrics-open;
                                    clicked => { root.lyrics-button(); }
                                }
                            }
                            Fold {
                                open: root.tool-queue;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.queue;
                                    label: Tr.w.queue;
                                    badge: root.queue-count > 0 ? "" + root.queue-count : "";
                                    active: root.page == 9;
                                    clicked => { root.queue-open(); }
                                }
                            }
                            if root.sleep-enabled: Fold {
                                open: root.tool-sleep;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.sleep;
                                    label: root.sleep-text;
                                    ring: root.sleep-ring;
                                    active: root.sleep-on || root.sleep-menu-open;
                                    clicked => {
                                        root.sleep-anchor = self.absolute-position.x + self.width / 2;
                                        root.sleep-cycle();
                                    }
                                }
                            }
                            if root.ab-enabled: Fold {
                                open: root.tool-ab;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.ab;
                                    label: root.ab-text;
                                    active: root.ab-stage == 2;
                                    badge: root.ab-stage == 1 ? "A" : "";
                                    clicked => { root.ab-cycle(); }
                                }
                            }
                            if root.eq-enabled: Fold {
                                open: root.tool-eq;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.equalizer;
                                    label: Tr.w.eq-button;
                                    active: root.eq-active;
                                    clicked => { root.eq-toggle(); }
                                }
                            }
                            if root.chapters-on: Fold {
                                open: root.tool-chapters;
                                IconButton {
                                    x: 1px;
                                    icon: Icons.chapters;
                                    label: Tr.w.chapters-button;
                                    clicked => { root.chapters-toggle(); }
                                }
                            }
                            // «⋯» — то, что не поместилось.
                            Fold {
                                open: root.more-needed;
                                more := IconButton {
                                    x: 1px;
                                    icon: Icons.more;
                                    label: Tr.w.more-tools;
                                    clicked => { more-menu.show(); }
                                    more-menu := PopupWindow {
                                        property <length> line: 36px;
                                        property <int> lines: (root.lyrics-enabled && !root.tool-lyrics ? 1 : 0) + (!root.tool-queue ? 1 : 0)
                                            + (root.sleep-enabled && !root.tool-sleep ? 1 : 0) + (root.ab-enabled && !root.tool-ab ? 1 : 0)
                                            + (root.eq-enabled && !root.tool-eq ? 1 : 0) + (root.chapters-on && !root.tool-chapters ? 1 : 0)
                                            + (root.speed-enabled && !root.speed-open ? 1 : 0);
                                        width: 250px;
                                        height: self.lines * self.line + 12px;
                                        x: parent.width - self.width;
                                        y: -self.height - 8px;
                                        Rectangle {
                                            background: Theme.surface;
                                            border-radius: Ui.radius-large;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            drop-shadow-blur: 16px;
                                            drop-shadow-color: #00000060;
                                            VerticalLayout {
                                                padding: 6px;
                                                if root.lyrics-enabled && !root.tool-lyrics: MenuRow {
                                                    icon: Icons.lyrics;
                                                    text: Tr.w.lyrics-button;
                                                    active: root.lyrics-open;
                                                    clicked => { root.lyrics-button(); }
                                                }
                                                if !root.tool-queue: MenuRow {
                                                    icon: Icons.queue;
                                                    text: Tr.w.queue + (root.queue-count > 0 ? " · " + root.queue-count : "");
                                                    active: root.page == 9;
                                                    clicked => { root.queue-open(); }
                                                }
                                                if root.sleep-enabled && !root.tool-sleep: MenuRow {
                                                    icon: Icons.sleep;
                                                    text: root.sleep-text;
                                                    active: root.sleep-on;
                                                    clicked => {
                                                        root.sleep-anchor = more.absolute-position.x + more.width / 2;
                                                        root.sleep-cycle();
                                                    }
                                                }
                                                if root.ab-enabled && !root.tool-ab: MenuRow {
                                                    icon: Icons.ab;
                                                    text: root.ab-text;
                                                    active: root.ab-stage == 2;
                                                    clicked => { root.ab-cycle(); }
                                                }
                                                if root.eq-enabled && !root.tool-eq: MenuRow {
                                                    icon: Icons.equalizer;
                                                    text: Tr.w.eq-button;
                                                    active: root.eq-active;
                                                    clicked => { root.eq-toggle(); }
                                                }
                                                if root.chapters-on && !root.tool-chapters: MenuRow {
                                                    icon: Icons.chapters;
                                                    text: Tr.w.chapters-button;
                                                    clicked => { root.chapters-toggle(); }
                                                }
                                                if root.speed-enabled && !root.speed-open: HorizontalLayout {
                                                    height: 36px;
                                                    padding-left: 10px;
                                                    padding-right: 6px;
                                                    spacing: 6px;
                                                    Text {
                                                        text: root.speed-text;
                                                        color: Theme.foreground;
                                                        vertical-alignment: center;
                                                        min-width: 44px;
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Mini {
                                                            height: 22px;
                                                            width: 28px;
                                                            text: "1×";
                                                            label: Tr.w.speed-reset;
                                                            clicked => { root.speed-reset(); }
                                                        }
                                                    }
                                                    Slider {
                                                        horizontal-stretch: 1;
                                                        accessible-label: Tr.w.speed;
                                                        minimum: 0.25;
                                                        maximum: 3;
                                                        step: 0.05;
                                                        value <=> root.speed;
                                                        changed(value) => { root.speed-changed(value); }
                                                        released(value) => { root.speed-released(value); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 0px;
                            speed-fold := Fold {
                                open: root.speed-open;
                                size: 150px;
                                height: 34px;
                                HorizontalLayout {
                                    x: 2px;
                                    width: 146px;
                                    alignment: end;
                                    spacing: 2px;
                                    Text {
                                        text: root.speed-text;
                                        font-size: 11px;
                                        color: Theme.foreground;
                                        opacity: 0.7;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Mini {
                                            height: 20px;
                                            width: 26px;
                                            text: "1×";
                                            label: Tr.w.speed-reset;
                                            clicked => { root.speed-reset(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Slider {
                                            width: 70px;
                                            accessible-label: Tr.w.speed;
                                            minimum: 0.25;
                                            maximum: 3;
                                            step: 0.05;
                                            value <=> root.speed;
                                            changed(value) => { root.speed-changed(value); }
                                            released(value) => { root.speed-released(value); }
                                        }
                                    }
                                }
                            }
                            BendVolume {
                                room: root.bar-right - speed-fold.width;
                                value <=> root.volume;
                                icon: root.volume <= 0.001 ? Icons.mute : root.volume < 0.5 ? Icons.volume-low : Icons.volume;
                                label: Tr.w.volume + " " + round(root.volume * 100) + "%";
                                changed(value) => { root.set-volume(value); }
                                mute => { root.mute-toggle(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Полный плеер: над страницами, под диалогами. Пока сворачивается, `full-shown` держит его.
    changed full-open => {
        if (root.full-open) {
            root.full-shown = true;
        }
    }
    Timer {
        interval: root.full-close-time;
        running: root.full-shown && !root.full-open;
        triggered => { root.full-shown = false; }
    }
    if root.full-shown: Rectangle {
        // Обложка из панели летит на место и обратно. Во время полёта меняется только её
        // прямоугольник: фон стоит, надписи проявляются после посадки — иначе 40–50 мс на кадр.
        property <bool> shown;
        property <bool> up: self.shown && root.full-open;
        // Обложка долетела: проявить надписи и кнопки.
        property <bool> landed;
        // Фон не успел к началу полёта — появится при посадке.
        property <bool> early;
        changed up => {
            if (self.up) {
                self.early = root.full-background.width > 0;
            } else {
                self.landed = false;
            }
        }
        Timer {
            interval: 1ms;
            running: !parent.shown;
            triggered => { parent.shown = true; }
        }
        Timer {
            interval: 360ms;
            running: parent.up && !parent.landed;
            triggered => { parent.landed = true; }
        }
        // Фон: сразу. Тянут вниз — светлеет, сворачивается — пропадает.
        Rectangle {
            background: Theme.deep;
            opacity: 1 - min(root.full-drag / root.height * 1.6, 0.6);
            visible: parent.up || root.full-dragging;
        }
        Image {
            width: 100%;
            height: 100%;
            source: root.full-background;
            // Фон уже в размер окна — по выборке на пиксель.
            image-fit: fill;
            image-rendering: pixelated;
            visible: (parent.early || parent.landed) && (parent.up || root.full-dragging);
            opacity: 1 - min(root.full-drag / root.height * 1.6, 0.6);
        }
        TouchArea {}
        full-content := Rectangle {
            y: root.full-drag;
            opacity: parent.up && (parent.landed || root.full-dragging) ? 1 : 0;
            // Невидимое не обходится при отрисовке вовсе.
            visible: self.opacity > 0.001;
            // Открытие — короткое проявление, закрытие — сразу.
            animate opacity { duration: root.full-open ? 100ms : 0ms; easing: ease-out; }
            // Полоса заголовка окна над строкой «свернуть», за неё тащат.
            if !root.os-fullscreen: DragArea {
                height: 48px;
                y: 0;
                drag => { root.window-drag(); }
                toggle => { root.window-maximize(); }
                menu(x, y) => { root.window-menu(x, y); }
            }
            VerticalLayout {
                padding: 24px;
                padding-top: root.os-fullscreen ? 16px : 52px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    IconButton {
                        size: 36px;
                        glyph: 22px;
                        tint: #ffffff;
                        icon: Icons.collapse;
                        label: Tr.w.full-collapse;
                        clicked => { root.full-toggle(); }
                    }
                    // Пустое место строки — заголовок окна.
                    DragArea {
                        horizontal-stretch: 1;
                        drag => { root.window-drag(); }
                        toggle => { root.window-maximize(); }
                        menu(x, y) => { root.window-menu(x, y); }
                    }
                    IconButton {
                        size: 36px;
                        glyph: 20px;
                        tint: #ffffff;
                        icon: root.os-fullscreen ? Icons.shrink : Icons.expand;
                        label: root.os-fullscreen ? Tr.w.full-window : Tr.w.full-screen;
                        clicked => { root.toggle-fullscreen(); }
                    }
                }
                // Место обложки (она летает поверх), справа — текст.
                middle := Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    property <length> side: min(self.height, root.full-lyrics ? self.width * 0.46 : self.width);
                    if root.full-lyrics: Rectangle {
                        x: parent.width / 2 + 12px;
                        width: parent.width / 2 - 12px;
                        height: parent.height;
                        if root.lyrics-synced && root.lyrics-look == 0: LyricsScroll {
                            width: parent.width;
                            height: parent.height;
                            lines: root.lyrics-lines;
                            small-size: 17px;
                            big-size: 24px;
                            tint: #ffffffa0;
                            highlight: #ffffff;
                            align: left;
                            line-clicked(index) => { root.lyrics-seek(index); }
                        }
                        if root.lyrics-synced && root.lyrics-look == 1: StageLyrics {
                            width: parent.width;
                            height: parent.height;
                            place: 1;
                            frame: root.stage-frame;
                            resized(place, width, height) => { root.stage-resized(place, width, height); }
                        }
                        if !root.lyrics-synced: ScrollView {
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.lyrics-plain;
                                    wrap: word-wrap;
                                    font-size: 16px;
                                    color: #ffffffd0;
                                }
                            }
                        }
                    }
                }
                CrossText {
                    text: root.now-title;
                    font-size: 26px;
                    font-weight: 700;
                    tint: #ffffff;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Link {
                        text: root.now-owner;
                        font-size: 17px;
                        rest-opacity: 0.85;
                        tint: #ffffff;
                        clicked => { root.open-now-artist(); }
                    }
                    if root.now-album != "": Text {
                        text: " · ";
                        font-size: 17px;
                        color: #ffffff;
                        opacity: 0.85;
                    }
                    if root.now-album != "": Link {
                        text: root.now-album;
                        font-size: 17px;
                        rest-opacity: 0.85;
                        tint: #ffffff;
                        clicked => { root.open-now-album(); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    if root.now-lyrics: VerticalLayout {
                        alignment: center;
                        LyricsMark { tint: #ffffff; }
                    }
                    if root.now-badge != "": VerticalLayout {
                        alignment: center;
                        Badge {
                            text: root.now-badge;
                            kind: root.now-badge-kind;
                            clickable: root.now-badge-clickable;
                            clicked => { root.badge-current(); }
                        }
                    }
                    Text {
                        text: root.now-quality;
                        font-size: 13px;
                        color: #ffffff;
                        opacity: 0.75;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.position-text;
                        width: 52px;
                        color: #ffffff;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    SeekBar {
                        horizontal-stretch: 1;
                        label: Tr.w.seek;
                        position: root.position;
                        duration: root.duration;
                        track: #ffffff30;
                        preview: #ffffff60;
                        fill: #ffffff;
                        dragging(on) => { root.seeking = on; }
                        seek(seconds) => {
                            root.position = seconds;
                            root.seek(seconds);
                        }
                    }
                    Text {
                        text: root.duration-text;
                        width: 52px;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            tint: #ffffff;
                            icon: Icons.heart;
                            highlight: false;
                            filled: root.now-liked;
                            active: root.now-liked;
                            label: root.now-liked ? Tr.w.unlike : Tr.w.like;
                            clicked => { root.like-current(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MediaButton {
                            kind: 2;
                            on-dark: true;
                            label: Tr.w.previous-track;
                            clicked => { root.previous(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MediaButton {
                            kind: root.playing ? 1 : 0;
                            primary: true;
                            width: 56px;
                            height: 40px;
                            label: root.playing ? Tr.w.pause : Tr.w.play;
                            clicked => { root.toggle(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        MediaButton {
                            kind: 3;
                            on-dark: true;
                            label: Tr.w.next-track;
                            clicked => { root.next(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            tint: #ffffff;
                            icon: Icons.plus;
                            label: Tr.w.add-menu;
                            clicked => { root.add-current(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            tint: #ffffff;
                            icon: root.repeat-mode == 1 ? Icons.repeat-one : Icons.repeat;
                            label: root.repeat-text;
                            active: root.repeat-on;
                            clicked => { root.cycle-repeat(); }
                        }
                    }
                    // Громкость гнётся и здесь, если окно узкое.
                    VerticalLayout {
                        alignment: center;
                        BendVolume {
                            room: root.full-volume-room;
                            length: 120px;
                            tint: #ffffff;
                            value <=> root.volume;
                            icon: root.volume <= 0.001 ? Icons.mute : root.volume < 0.5 ? Icons.volume-low : Icons.volume;
                            label: Tr.w.volume + " " + round(root.volume * 100) + "%";
                            changed(value) => { root.set-volume(value); }
                            mute => { root.mute-toggle(); }
                        }
                    }
                }
                // Строка «Дальше» держит место и у последнего трека: иначе всё сдвигалось.
                Text {
                    text: root.full-next != "" ? Tr.w.next-up + " " + root.full-next : " ";
                    font-size: 13px;
                    color: #ffffff;
                    opacity: root.full-next != "" ? 0.7 : 0;
                    animate opacity { duration: 200ms; }
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
        // Обложка из панели: вылетает на место и садится обратно. Летят центр и сторона —
        // растёт вокруг середины и не вылезает за край.
        Rectangle {
            property <length> center-x: parent.up
                ? middle.absolute-position.x - parent.absolute-position.x + (root.full-lyrics ? middle.width / 4 : middle.width / 2) + root.full-shift
                : bar-cover.absolute-position.x - parent.absolute-position.x + bar-cover.width / 2;
            property <length> center-y: parent.up
                ? middle.absolute-position.y - parent.absolute-position.y + middle.height / 2
                : bar-cover.absolute-position.y - parent.absolute-position.y + bar-cover.height / 2;
            property <length> side: parent.up ? middle.side : bar-cover.width;
            // Пока жест ведёт обложку (вниз или вбок) — без задержки.
            animate center-x, center-y { duration: root.swiping && (root.full-dragging || root.full-shift != 0) ? 0ms : 380ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            animate side, border-radius { duration: 380ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            x: self.center-x - self.side / 2;
            y: self.center-y - self.side / 2;
            width: self.side;
            height: self.side;
            border-radius: parent.up ? Ui.radius-large : Ui.radius;
            clip: true;
            // Подложка только без обложки.
            background: root.full-cover.width > 0 || root.now-cover.width > 0 ? transparent : #ffffff14;
            // Пока большая обложка грузится — та, что в панели.
            CrossImage {
                width: 100%;
                height: 100%;
                source: root.full-cover.width > 0 ? root.full-cover : root.now-cover;
                fit: contain;
            }
            TouchArea {
                clicked => { root.full-toggle(); }
            }
        }
    }

    // Сезонная сценка — поверх всего, ненадолго.
    if root.season-episode != 0: SeasonEpisode {
        width: root.width;
        height: root.height - 92px;
        kind: root.season-episode;
    }

    // Стрелка жеста: выезжает, у порога заливается.
    Rectangle {
        property <float> pass: min(root.swipe-progress, 1);
        property <bool> armed: root.swipe-progress >= 1;
        property <bool> left: root.swipe-kind == 1 || root.swipe-kind == 4;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        // По треку — у самого трека, иначе — из края окна.
        x: root.swipe-place == 1
            ? (self.left ? 8px + self.pass * 16px : root.bar-track-right - 56px - self.pass * 16px)
            : (self.left ? -48px + self.pass * 72px : root.width - self.pass * 72px);
        y: root.swipe-place == 1 ? root.height - 46px - 24px : (root.height - 92px) / 2 - 24px;
        opacity: min(1, self.pass * 1.6);
        visible: self.opacity > 0.01;
        animate x, opacity { duration: root.swiping ? 0ms : 200ms; easing: ease-out; }
        background: self.armed ? Theme.accent : #3a3a3af2;
        border-width: 1px;
        border-color: #ffffff24;
        animate background { duration: 120ms; }
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            icon: root.swipe-kind == 1 ? Icons.back : root.swipe-kind == 2 ? Icons.forward : root.swipe-kind == 3 ? Icons.next : Icons.previous;
            tint: parent.armed ? Theme.accent-foreground : #ffffff;
        }
    }

    // Сведения о треке.
    if root.info-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 820px);
            height: parent.height - 60px;
            x: (parent.width - self.width) / 2;
            y: 30px;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.info-title;
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.foreground;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if root.advanced: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.edit;
                            label: Tr.w.edit-lyrics;
                            clicked => { root.info-lyrics(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.close;
                            label: Tr.w.close;
                            clicked => { root.info-close(); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if root.info-badge != "": VerticalLayout {
                        alignment: center;
                        Badge {
                            text: root.info-badge;
                            kind: root.info-badge-kind;
                        }
                    }
                    Text {
                        text: root.info-quality;
                        color: Theme.foreground;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Heading { text: Tr.w.file; }
                        for row in root.info-rows: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.name;
                                width: 170px;
                                color: Theme.foreground;
                                opacity: 0.6;
                            }
                            Text {
                                text: row.value;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                color: Theme.foreground;
                            }
                        }
                        Heading { text: Tr.w.tags + " (" + root.info-tag-kind + ")"; }
                        if !root.info-editable: VerticalLayout {
                            spacing: 4px;
                            for row in root.info-tags: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.key;
                                    width: 170px;
                                    color: Theme.foreground;
                                    opacity: 0.6;
                                }
                                Text {
                                    text: row.value;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    color: Theme.foreground;
                                }
                            }
                        }
                        if root.info-editable: VerticalLayout {
                            spacing: 4px;
                            for row[index] in root.info-tags: HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    width: 180px;
                                    text: row.key;
                                    edited(text) => { root.tag-key-edited(index, text); }
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: row.value;
                                    edited(text) => { root.tag-value-edited(index, text); }
                                }
                                Button {
                                    text: "×";
                                    clicked => { root.tag-remove(index); }
                                }
                            }
                        }
                        if root.info-editable: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "+ " + Tr.w.add-field;
                                clicked => { root.tag-add(); }
                            }
                        }
                    }
                }
                if root.info-message != "": Text {
                    text: root.info-message;
                    wrap: word-wrap;
                    color: Theme.foreground;
                    opacity: 0.8;
                }
                if root.info-editable && !root.info-confirm: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.info-can-undo: Button {
                        text: Tr.w.undo;
                        clicked => { root.tags-undo(); }
                    }
                    Button {
                        text: Tr.w.reset-edits;
                        enabled: root.info-dirty;
                        clicked => { root.tags-reset(); }
                    }
                    Button {
                        text: Tr.w.save-to-file;
                        primary: true;
                        enabled: root.info-dirty;
                        clicked => { root.info-confirm = true; }
                    }
                }
                if root.info-editable && root.info-confirm: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Text {
                        text: Tr.w.confirm-write;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.no;
                        clicked => { root.info-confirm = false; }
                    }
                    Button {
                        text: Tr.w.yes-write;
                        primary: true;
                        clicked => {
                            root.info-confirm = false;
                            root.tags-save();
                        }
                    }
                }
            }
        }
    }

    // Выбор плейлиста для «+».
    if root.picker-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 420px);
            height: min(parent.height - 60px, 480px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                if root.picker-queue-options: Text {
                    text: Tr.w.queue;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                if root.picker-queue-options: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: Tr.w.play-next;
                        clicked => { root.picker-queue(true); }
                    }
                    Button {
                        text: Tr.w.add-to-queue;
                        primary: true;
                        clicked => { root.picker-queue(false); }
                    }
                }
                Text {
                    text: Tr.w.add-to-playlist;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                ListView {
                    vertical-stretch: 1;
                    for row[index] in root.playlists: ArtistLine {
                        data: row;
                        clicked => { root.picker-choose(index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: Tr.w.new-playlist;
                        text <=> root.new-playlist-name;
                        accepted(text) => { root.picker-create(text); }
                    }
                    Button {
                        text: Tr.w.create;
                        clicked => { root.picker-create(root.new-playlist-name); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.picker-close(); }
                    }
                }
            }
        }
    }
    // Подлинность качества: почему значок красный и что с ним делать.
    if root.quality-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 640px);
            height: min(parent.height - 60px, 460px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Tr.w.quality-heading;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.quality-title;
                    color: Theme.foreground;
                    opacity: 0.8;
                    overflow: elide;
                }
                Text {
                    text: root.quality-claim;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                Text {
                    text: root.quality-reason;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                Text {
                    text: root.quality-detected;
                    wrap: word-wrap;
                    font-weight: 600;
                    color: Theme.foreground;
                }
                Text {
                    text: Tr.w.heuristic-note;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.6;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: Tr.w.replace-with;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 140px;
                        // Порядок совпадает с QUALITY_LABELS в main.rs.
                        model: ["Hi-Res", "CD", "MP3", "AAC", "Lossy"];
                        current-index <=> root.quality-label-index;
                    }
                    Button {
                        text: Tr.w.replace;
                        clicked => { root.quality-replace(root.quality-label-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.quality-overridden: Button {
                        text: Tr.w.restore-check;
                        clicked => { root.quality-reset(); }
                    }
                    Button {
                        text: Tr.w.use-detected;
                        clicked => { root.quality-use-detected(); }
                    }
                    Button {
                        text: Tr.w.keep-as-is;
                        clicked => { root.quality-accept(); }
                    }
                    Button {
                        text: Tr.w.close;
                        primary: true;
                        clicked => { root.quality-close(); }
                    }
                }
            }
        }
    }
    // Предупреждение: включить подлинность, выключить кэш обложек.
    if root.warning-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 460px);
            height: warning.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            warning := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.warning-kind == 1 ? Tr.w.covers-warning-title : Tr.w.warning-title;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                Text {
                    text: root.warning-kind == 1 ? Tr.w.covers-warning-body : Tr.w.warning-body;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.warning-cancel(); }
                    }
                    Button {
                        text: root.warning-kind == 1 ? Tr.w.disable : Tr.w.enable;
                        primary: true;
                        clicked => { root.warning-confirm(); }
                    }
                }
            }
        }
    }
    // Редактор текста: текст → синхронизация → файл LRC.
    if root.editor-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: parent.width - 40px;
            height: parent.height - 40px;
            x: 20px;
            y: 20px;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: Tr.w.lyrics-editor + ": " + root.editor-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.foreground;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Tab {
                        text: Tr.w.step-text;
                        selected: root.editor-step == 0;
                        clicked => { root.editor-go(0); }
                    }
                    Tab {
                        text: Tr.w.step-sync;
                        selected: root.editor-step == 1;
                        clicked => { root.editor-go(1); }
                    }
                    Tab {
                        text: Tr.w.step-lrc;
                        selected: root.editor-step == 2;
                        clicked => { root.editor-go(2); }
                    }
                }

                // Шаг 1: текст.
                if root.editor-step == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text {
                        text: Tr.w.text-hint;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.foreground;
                        opacity: 0.7;
                    }
                    TextEdit {
                        vertical-stretch: 1;
                        text <=> root.editor-plain;
                        edited(text) => { root.editor-plain-edited(text); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: Tr.w.next-step + " →";
                            primary: true;
                            clicked => { root.editor-go(1); }
                        }
                    }
                }

                // Шаг 2: синхронизация. Клавиши работают, пока фокус здесь.
                if root.editor-step == 1: sync-keys := FocusScope {
                    in property <int> focus-line: root.editor-focus-line;
                    vertical-stretch: 1;
                    init => { self.focus(); }
                    // Строка с ● держится в верхней трети списка.
                    changed focus-line => {
                        list.content-y = max(
                            min(0px, list.visible-height / 3 - self.focus-line * 34px),
                            min(0px, list.visible-height - list.content-height));
                    }
                    key-pressed(event) => {
                        if (event.text == " ") {
                            root.editor-stamp();
                            return accept;
                        }
                        if (event.text == Key.Backspace) {
                            root.editor-unstamp();
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            root.editor-move(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.editor-move(1);
                            return accept;
                        }
                        if (event.text == Key.LeftArrow) {
                            root.editor-nudge(-1, event.modifiers.shift ? -100 : -10);
                            return accept;
                        }
                        if (event.text == Key.RightArrow) {
                            root.editor-nudge(-1, event.modifiers.shift ? 100 : 10);
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            root.editor-play-line(-1);
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.editor-close(false);
                            return accept;
                        }
                        return reject;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: Tr.w.sync-hint;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Theme.foreground;
                            opacity: 0.7;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "−5 " + Tr.w.sec;
                                clicked => {
                                    root.editor-seek-by(-5000);
                                    sync-keys.focus();
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MediaButton {
                                    kind: root.editor-playing ? 1 : 0;
                                    primary: true;
                                    label: root.editor-playing ? Tr.w.pause : Tr.w.play;
                                    clicked => {
                                        root.editor-play-pause();
                                        sync-keys.focus();
                                    }
                                }
                            }
                            Button {
                                text: "+5 " + Tr.w.sec;
                                clicked => {
                                    root.editor-seek-by(5000);
                                    sync-keys.focus();
                                }
                            }
                            Text {
                                text: root.editor-position;
                                font-size: 18px;
                                font-weight: 700;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                width: 110px;
                                horizontal-alignment: center;
                            }
                            Button {
                                text: Tr.w.stamp;
                                primary: true;
                                clicked => {
                                    root.editor-stamp();
                                    sync-keys.focus();
                                }
                            }
                            Button {
                                text: Tr.w.unstamp;
                                clicked => {
                                    root.editor-unstamp();
                                    sync-keys.focus();
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: Tr.w.speed + ":";
                                vertical-alignment: center;
                                color: Theme.foreground;
                            }
                            Slider {
                                width: 160px;
                                minimum: 0.05;
                                maximum: 1;
                                step: 0.05;
                                value <=> root.editor-speed;
                                changed(value) => { root.editor-speed-changed(value); }
                                released(value) => {
                                    root.editor-speed-released(value);
                                    sync-keys.focus();
                                }
                            }
                            Text {
                                width: 48px;
                                text: root.editor-speed-text;
                                vertical-alignment: center;
                                color: Theme.foreground;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: Tr.w.shift-all;
                                vertical-alignment: center;
                                color: Theme.foreground;
                            }
                            Mini {
                                width: 52px;
                                text: "−100";
                                label: Tr.w.shift-all + " −100";
                                clicked => { root.editor-shift-all(-100); }
                            }
                            Mini {
                                width: 44px;
                                text: "−10";
                                label: Tr.w.shift-all + " −10";
                                clicked => { root.editor-shift-all(-10); }
                            }
                            Mini {
                                width: 44px;
                                text: "+10";
                                label: Tr.w.shift-all + " +10";
                                clicked => { root.editor-shift-all(10); }
                            }
                            Mini {
                                width: 52px;
                                text: "+100";
                                label: Tr.w.shift-all + " +100";
                                clicked => { root.editor-shift-all(100); }
                            }
                            Rectangle { width: 16px; }
                            Text {
                                text: Tr.w.tap-offset;
                                vertical-alignment: center;
                                color: Theme.foreground;
                            }
                            LineEdit {
                                width: 80px;
                                text: root.editor-tap-offset;
                                edited(text) => { root.editor-tap-offset-changed(round(text.to-float())); }
                                accepted(text) => {
                                    root.editor-tap-offset-changed(round(text.to-float()));
                                    sync-keys.focus();
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.editor-summary;
                                vertical-alignment: center;
                                color: Theme.foreground;
                                opacity: 0.7;
                            }
                        }
                        // Весь трек: метки строк и место воспроизведения, клик — перемотка.
                        overview := Rectangle {
                            height: 26px;
                            background: Theme.surface;
                            border-radius: Ui.radius-small;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.editor-overview;
                                image-fit: fill;
                                colorize: Theme.foreground.transparentize(50%);
                            }
                            for mark in root.editor-overview-marks: Rectangle {
                                x: mark.x * overview.width;
                                width: 1px;
                                height: overview.height;
                                background: mark.selected ? Theme.accent : #e0a020;
                            }
                            Rectangle {
                                x: root.editor-overview-position * overview.width - 1px;
                                width: 2px;
                                height: overview.height;
                                background: Theme.accent;
                            }
                            TouchArea {
                                clicked => {
                                    root.editor-overview-seek(self.mouse-x / self.width);
                                    sync-keys.focus();
                                }
                            }
                        }
                        // Крупно ±5 с вокруг места: метку можно тянуть, клик — перемотка.
                        zoom := Rectangle {
                            height: 92px;
                            background: Theme.surface;
                            border-radius: Ui.radius-small;
                            clip: true;
                            Image {
                                width: zoom.width * 3;
                                x: -root.editor-wave-shift * zoom.width;
                                height: parent.height;
                                source: root.editor-wave;
                                image-fit: fill;
                                colorize: Theme.foreground.transparentize(25%);
                            }
                            TouchArea {
                                clicked => {
                                    root.editor-wave-seek(self.mouse-x / self.width);
                                    sync-keys.focus();
                                }
                            }
                            Rectangle {
                                x: zoom.width / 2 - 1px;
                                width: 2px;
                                height: zoom.height;
                                background: Theme.accent;
                            }
                            for mark in root.editor-wave-marks: Rectangle {
                                property <length> shift: grip.pressed ? grip.mouse-x - grip.pressed-x : 0px;
                                x: (mark.x * 3 - root.editor-wave-shift) * zoom.width + self.shift - 1px;
                                width: 3px;
                                height: zoom.height;
                                background: mark.selected ? Theme.accent : #e0a020;
                                Text {
                                    x: 5px;
                                    y: 2px;
                                    text: mark.label;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: mark.selected ? Theme.accent : #b07800;
                                }
                                grip := TouchArea {
                                    x: -6px;
                                    width: 15px;
                                    mouse-cursor: ew-resize;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            root.editor-drag(true);
                                        } else if (event.kind == PointerEventKind.up) {
                                            if (abs(self.mouse-x - self.pressed-x) < 2px) {
                                                root.editor-select(mark.index);
                                            } else {
                                                root.editor-mark-dropped(mark.index, mark.x + (self.mouse-x - self.pressed-x) / (zoom.width * 3));
                                            }
                                            root.editor-drag(false);
                                            sync-keys.focus();
                                        } else if (event.kind == PointerEventKind.cancel) {
                                            root.editor-drag(false);
                                        }
                                    }
                                }
                            }
                            if !root.editor-wave-ready: Text {
                                width: zoom.width;
                                height: zoom.height;
                                text: Tr.w.wave-wait;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: Theme.foreground;
                                opacity: 0.6;
                            }
                        }
                        list := ListView {
                            vertical-stretch: 1;
                            for line[index] in root.editor-lines: Rectangle {
                                height: 34px;
                                background: line.selected ? Theme.surface : transparent;
                                border-radius: 4px;
                                TouchArea {
                                    clicked => {
                                        root.editor-select(index);
                                        sync-keys.focus();
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    Text {
                                        width: 14px;
                                        text: line.next ? "●" : "";
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        width: 96px;
                                        text <=> line.time;
                                        accepted(text) => {
                                            root.editor-set-time(index, text);
                                            sync-keys.focus();
                                        }
                                    }
                                    Mini {
                                        width: 40px;
                                        text: "−0.1";
                                        label: "−100 ms";
                                        clicked => { root.editor-nudge(index, -100); }
                                    }
                                    Mini {
                                        width: 44px;
                                        text: "−0.01";
                                        label: "−10 ms";
                                        clicked => { root.editor-nudge(index, -10); }
                                    }
                                    Mini {
                                        width: 44px;
                                        text: "+0.01";
                                        label: "+10 ms";
                                        clicked => { root.editor-nudge(index, 10); }
                                    }
                                    Mini {
                                        width: 40px;
                                        text: "+0.1";
                                        label: "+100 ms";
                                        clicked => { root.editor-nudge(index, 100); }
                                    }
                                    Text {
                                        text: line.text == "" ? "♪" : line.text;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        font-weight: line.current ? 700 : 400;
                                        color: line.warn ? #d23b3b : line.current ? Theme.accent : Theme.foreground;
                                    }
                                    Mini {
                                        text: "►";
                                        label: Tr.w.play;
                                        clicked => {
                                            root.editor-play-line(index);
                                            sync-keys.focus();
                                        }
                                    }
                                    Mini {
                                        text: "×";
                                        label: Tr.w.unstamp;
                                        clicked => { root.editor-clear-line(index); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Шаг 3: файл целиком.
                if root.editor-step == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text {
                        text: Tr.w.lrc-hint;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.foreground;
                        opacity: 0.7;
                    }
                    TextEdit {
                        vertical-stretch: 1;
                        text <=> root.editor-raw;
                        edited(text) => { root.editor-raw-edited(text); }
                    }
                }

                if root.editor-message != "": Text {
                    text: root.editor-message;
                    wrap: word-wrap;
                    color: Theme.foreground;
                    opacity: 0.8;
                }
                if root.editor-confirm-save: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.editor-confirm-text;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.editor-confirm-save = false; }
                    }
                    Button {
                        text: Tr.w.yes-write;
                        primary: true;
                        clicked => { root.editor-write(); }
                    }
                }
                if !root.editor-confirm-close && !root.editor-confirm-save: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.editor-can-undo: Button {
                        text: Tr.w.undo;
                        clicked => { root.editor-undo(); }
                    }
                    Button {
                        text: Tr.w.save-lrc;
                        primary: true;
                        enabled: root.editor-dirty;
                        clicked => { root.editor-save(); }
                    }
                    Button {
                        text: Tr.w.close;
                        clicked => { root.editor-close(false); }
                    }
                }
                if root.editor-confirm-close: HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Text {
                        text: Tr.w.close-unsaved;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.editor-confirm-close = false; }
                    }
                    Button {
                        text: Tr.w.discard;
                        clicked => { root.editor-close(true); }
                    }
                }
            }
        }
    }
    // Как раскладывать новую папку.
    if root.folder-choice-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 460px);
            height: choice.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            choice := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Tr.w.folder-choice;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.folder-choice-path;
                    color: Theme.foreground;
                    opacity: 0.6;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.folder-choice(-1); }
                    }
                    if root.classical: Button {
                        text: Tr.w.by-composers;
                        clicked => { root.folder-choice(2); }
                    }
                    Button {
                        text: Tr.w.by-tags;
                        clicked => { root.folder-choice(1); }
                    }
                    Button {
                        text: Tr.w.by-folders;
                        primary: true;
                        clicked => { root.folder-choice(0); }
                    }
                }
            }
        }
    }

    // Подтверждение, иногда со списком «что изменится».
    if root.confirm-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        // Без списка — по размеру текста.
        property <bool> rows: root.confirm-rows.length > 0;
        Rectangle {
            width: min(parent.width - 60px, parent.rows ? 760px : 460px);
            height: parent.rows ? min(parent.height - 60px, 560px) : confirm.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            confirm := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.confirm-title;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-body;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                if root.confirm-rows.length > 0: ListView {
                    vertical-stretch: 1;
                    for row in root.confirm-rows: HorizontalLayout {
                        spacing: 10px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            width: 320px;
                            text: row.name;
                            overflow: elide;
                            color: Theme.foreground;
                            opacity: 0.6;
                        }
                        Text {
                            text: "→";
                            color: Theme.foreground;
                        }
                        Text {
                            text: row.value;
                            horizontal-stretch: 1;
                            overflow: elide;
                            color: Theme.foreground;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.confirm-cancel(); }
                    }
                    if root.confirm-yes != "": Button {
                        text: root.confirm-yes;
                        primary: true;
                        clicked => { root.confirm-accept(); }
                    }
                }
            }
        }
    }
    // Главы и закладки длинной записи.
    if root.chapters-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {
            clicked => { root.chapters-close(); }
        }
        Rectangle {
            width: min(parent.width - 60px, 640px);
            height: parent.height - 120px;
            x: (parent.width - self.width) / 2;
            y: 30px;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Tr.w.chapters-title + ": " + root.chapters-track;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                    color: Theme.foreground;
                }
                if root.chapter-rows.length == 0: Text {
                    text: Tr.w.no-chapters;
                    wrap: word-wrap;
                    color: Theme.foreground;
                    opacity: 0.7;
                }
                ListView {
                    vertical-stretch: 1;
                    for row[index] in root.chapter-rows: Line {
                        height: 34px;
                        label: row.time + " " + row.name;
                        clicked => { root.chapter-jump(index); }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 10px;
                            Text {
                                width: 70px;
                                text: row.time;
                                vertical-alignment: center;
                                color: Theme.foreground;
                                opacity: 0.7;
                            }
                            Text {
                                text: (row.bookmark ? "★ " : "") + row.name;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                font-weight: row.current ? 700 : 400;
                                color: row.current ? Theme.accent : Theme.foreground;
                            }
                            if row.bookmark: Mini {
                                text: "×";
                                label: Tr.w.remove-from-playlist;
                                clicked => { root.bookmark-delete(index); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: Tr.w.bookmark-name;
                        text <=> root.bookmark-name;
                        accepted(text) => { root.bookmark-add(text); }
                    }
                    Button {
                        text: Tr.w.add-bookmark + " (" + root.bookmark-time + ")";
                        clicked => { root.bookmark-add(root.bookmark-name); }
                    }
                    Button {
                        text: Tr.w.close;
                        clicked => { root.chapters-close(); }
                    }
                }
            }
        }
    }
    // Правила умного плейлиста.
    if root.smart-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 760px);
            height: parent.height - 60px;
            x: (parent.width - self.width) / 2;
            y: 30px;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Tr.w.smart-title;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: Tr.w.smart-name;
                        text <=> root.smart-name;
                    }
                    Text {
                        text: Tr.w.smart-preset;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 260px;
                        model: root.smart-presets;
                        current-index: -1;
                        selected(value) => { root.smart-preset(self.current-index); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Tr.w.smart-match;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 240px;
                        model: [Tr.w.smart-match-all, Tr.w.smart-match-any];
                        current-index <=> root.smart-match;
                        selected(value) => { root.smart-changed(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                ListView {
                    vertical-stretch: 1;
                    for row[index] in root.smart-conditions: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        ComboBox {
                            width: 300px;
                            model: root.smart-kinds;
                            current-index: row.kind;
                            selected(value) => { root.smart-kind-changed(index, self.current-index); }
                        }
                        if row.needs-value: LineEdit {
                            horizontal-stretch: 1;
                            text: row.value;
                            edited(text) => { root.smart-value-edited(index, text); }
                        }
                        if !row.needs-value: Rectangle { horizontal-stretch: 1; }
                        Mini {
                            text: "×";
                            label: Tr.w.remove-from-playlist;
                            clicked => { root.smart-remove-condition(index); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: Tr.w.smart-add;
                        clicked => { root.smart-add-condition(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: Tr.w.smart-order;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 220px;
                        model: root.smart-orders;
                        current-index <=> root.smart-order;
                        selected(value) => { root.smart-changed(); }
                    }
                    Text {
                        text: Tr.w.smart-limit;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    LineEdit {
                        width: 80px;
                        placeholder-text: Tr.w.smart-limit-all;
                        text <=> root.smart-limit;
                        edited(text) => { root.smart-changed(); }
                    }
                }
                if !root.statistics: Text {
                    text: Tr.w.smart-needs-stats;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.7;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.smart-message;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.cancel;
                        clicked => { root.smart-close(); }
                    }
                    Button {
                        text: Tr.w.save;
                        primary: true;
                        enabled: root.smart-name != "";
                        clicked => { root.smart-save(); }
                    }
                }
            }
        }
    }
    // Эквалайзер.
    if root.eq-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {
            clicked => { root.eq-close(); }
        }
        Rectangle {
            width: min(parent.width - 60px, 860px);
            height: parent.height - 40px;
            x: (parent.width - self.width) / 2;
            y: 20px;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Tr.w.eq-title;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Switch {
                        text: Tr.w.eq-on;
                        checked <=> root.eq-active;
                        toggled => { root.eq-active-changed(self.checked); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: Tr.w.eq-import;
                        clicked => { root.eq-import(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Tr.w.eq-profile;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 220px;
                        model: root.eq-profiles;
                        current-index <=> root.eq-profile-index;
                        selected(value) => { root.eq-profile-chosen(self.current-index); }
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: Tr.w.eq-profile-name;
                        text <=> root.eq-profile-name;
                    }
                    Button {
                        text: Tr.w.eq-profile-save;
                        clicked => { root.eq-profile-save(root.eq-profile-name); }
                    }
                    Button {
                        text: Tr.w.eq-profile-delete;
                        enabled: root.eq-profile-index >= 0;
                        clicked => { root.eq-profile-delete(); }
                    }
                }
                Rectangle {
                    height: 120px;
                    background: Theme.surface;
                    border-radius: Ui.radius;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.eq-curve;
                        image-fit: fill;
                        colorize: Theme.accent;
                    }
                    Text {
                        x: 6px;
                        y: 2px;
                        text: "+15";
                        font-size: 10px;
                        color: Theme.foreground;
                        opacity: 0.5;
                    }
                    Text {
                        x: 6px;
                        y: parent.height - 14px;
                        text: Tr.w.eq-scale;
                        font-size: 10px;
                        color: Theme.foreground;
                        opacity: 0.5;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 150px;
                        text: Tr.w.eq-preamp + " " + round(root.eq-preamp * 10) / 10;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Slider {
                        minimum: -20;
                        maximum: 6;
                        value <=> root.eq-preamp;
                        changed(value) => { root.eq-preamp-changed(value); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 170px;
                        font-size: 11px;
                        opacity: 0.6;
                        color: Theme.foreground;
                    }
                    Text {
                        width: 90px;
                        text: Tr.w.eq-freq;
                        font-size: 11px;
                        opacity: 0.6;
                        color: Theme.foreground;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Tr.w.eq-gain;
                        font-size: 11px;
                        opacity: 0.6;
                        color: Theme.foreground;
                    }
                    Text {
                        width: 70px;
                        text: Tr.w.eq-q;
                        font-size: 11px;
                        opacity: 0.6;
                        color: Theme.foreground;
                    }
                    Rectangle { width: 28px; }
                }
                ListView {
                    vertical-stretch: 1;
                    for band[index] in root.eq-rows: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        ComboBox {
                            width: 170px;
                            model: [Tr.w.f-peak, Tr.w.f-low-shelf, Tr.w.f-high-shelf, Tr.w.f-low-pass, Tr.w.f-high-pass];
                            current-index: band.kind;
                            selected(value) => { root.eq-kind-changed(index, self.current-index); }
                        }
                        LineEdit {
                            width: 90px;
                            text: band.freq;
                            edited(text) => { root.eq-freq-edited(index, text); }
                        }
                        Slider {
                            horizontal-stretch: 1;
                            minimum: -15;
                            maximum: 15;
                            value: band.gain;
                            enabled: band.kind < 3;
                            changed(value) => { root.eq-gain-changed(index, value); }
                        }
                        Text {
                            width: 44px;
                            text: band.kind < 3 ? round(band.gain * 10) / 10 + "" : "—";
                            vertical-alignment: center;
                            color: Theme.foreground;
                        }
                        LineEdit {
                            width: 70px;
                            text: band.q;
                            edited(text) => { root.eq-q-edited(index, text); }
                        }
                        Mini {
                            text: "×";
                            label: Tr.w.remove-from-playlist;
                            clicked => { root.eq-remove(index); }
                        }
                    }
                }
                if root.device-profiles && root.eq-device != "": Text {
                    text: Tr.w.eq-device + ": " + root.eq-device + ". " + Tr.w.eq-device-hint;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.7;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: Tr.w.eq-add;
                        clicked => { root.eq-add(); }
                    }
                    Button {
                        text: Tr.w.eq-reset;
                        clicked => { root.eq-reset(); }
                    }
                    Text {
                        text: root.eq-message;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.close;
                        clicked => { root.eq-close(); }
                    }
                }
            }
        }
    }
    // Конвертация альбома или плейлиста.
    if root.convert-open: Rectangle {
        property <bool> shown;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        init => { self.shown = true; }
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: min(parent.width - 60px, 640px);
            height: 330px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.background;
            border-radius: Ui.radius-huge;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Tr.w.convert-title + " · " + root.convert-count;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 90px;
                        text: Tr.w.convert-format;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 160px;
                        model: ["FLAC", "WAV"];
                        current-index <=> root.convert-format;
                        enabled: !root.convert-busy;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 90px;
                        text: Tr.w.convert-quality;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    ComboBox {
                        width: 260px;
                        model: [Tr.w.q-as-is, Tr.w.q-cd, Tr.w.q-hires];
                        current-index <=> root.convert-quality;
                        enabled: !root.convert-busy;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 90px;
                        text: Tr.w.convert-folder;
                        vertical-alignment: center;
                        color: Theme.foreground;
                    }
                    Text {
                        text: root.convert-folder;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.foreground;
                    }
                    Button {
                        text: Tr.w.convert-choose;
                        enabled: !root.convert-busy;
                        clicked => { root.convert-choose(); }
                    }
                }
                Text {
                    text: Tr.w.convert-note;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.foreground;
                    opacity: 0.6;
                }
                Text {
                    vertical-stretch: 1;
                    text: root.convert-message;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.convert-busy: Button {
                        text: Tr.w.convert-stop;
                        clicked => { root.convert-stop(); }
                    }
                    Button {
                        text: Tr.w.convert-start;
                        primary: true;
                        enabled: !root.convert-busy && root.convert-folder != "";
                        clicked => { root.convert-start(); }
                    }
                    Button {
                        text: Tr.w.close;
                        clicked => { root.convert-close(); }
                    }
                }
            }
        }
    }
    // ↑ окна

    // Меню таймера сна — над кнопкой «Сон»; нажатие мимо закрывает его.
    if root.sleep-menu-open: Rectangle {
        TouchArea {
            clicked => { root.sleep-menu-open = false; }
        }
        SleepMenu {
            x: clamp(root.sleep-anchor - self.width / 2, 8px, root.width - self.width - 8px);
            y: root.height - 100px - self.height;
            hours: root.sleep-hours;
            minutes: root.sleep-minutes;
            day: root.sleep-day;
            left: root.sleep-plan;
            arc: root.sleep-arc;
            handle-x: root.sleep-handle-x;
            handle-y: root.sleep-handle-y;
            now-x: root.sleep-now-x;
            now-y: root.sleep-now-y;
            running: root.sleep-running;
            after-track: root.sleep-after-track;
            step(part, delta) => { root.sleep-step(part, delta); }
            dial(x, y, start) => { root.sleep-dial(x, y, start); }
            wheel(delta) => { root.sleep-wheel(delta); }
            start => { root.sleep-start(); }
            stop => { root.sleep-stop(); }
            after-track-toggle => { root.sleep-after-toggle(); }
            close => { root.sleep-menu-open = false; }
        }
    }

    // Кнопки окна справа вверху (во весь экран — нет) и тонкая граница по краю.
    if !root.os-fullscreen && !root.window-maximized: Rectangle {
        border-width: 1px;
        border-color: Theme.border;
    }
    if !root.os-fullscreen: WindowButtons {
        x: root.width - self.preferred-width - 8px;
        y: 10px;
        height: 32px;
        maximized: root.window-maximized;
        // Над полноэкранным плеером (фон — размытая обложка) — белые.
        tint: root.full-covers ? #ffffff : Theme.foreground;
        minimize-label: Tr.w.window-minimize;
        maximize-label: Tr.w.window-maximize;
        restore-label: Tr.w.window-restore;
        close-label: Tr.w.window-close;
        minimize => { root.window-minimize(); }
        maximize => { root.window-maximize(); }
        close => { root.window-close(); }
    }

    // Подсказки к значкам — поверх всего.
    TipLayer {
        width: root.width;
        height: root.height;
    }
}
