// Главное окно Nyanoto.

import { ListView, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { BendVolume, Button, ComboBox, DragArea, Fold, LineEdit, Slider, Switch, WidgetWords, WindowButtons } from "widgets.slint";
import { Theme } from "theme.slint";
import { SeasonBadge, SeasonDecor, SeasonEpisode } from "season.slint";
// Моноширинный шрифт темы «Терминал» — встроен: одинаков в Linux, Windows и Android.
import "../fonts/JetBrainsMono-Regular.otf";
import "../fonts/JetBrainsMono-Bold.otf";
import { Appear, CrossImage, CrossText, Icons, Icon, IconButton, NavItem, Reveal, SeekBar, Tip, TipLayer, Ui } from "icons.slint";
import { ThemeCard, ArtistRow, BrowseRow, RootRow, AlbumRow, TrackRow, QueueRow, InfoRow, TagRow, OptionRow, GraphNode, AboutRow, Words, WaveMark, EditorLine, ChapterRow, SmartRow, HealthRow, EqRow, HistoryRow, LyricRow, Tr, Cover, Line, Mini, MediaButton, DevBadge, Badge, LyricsMark, ArtistLine, DailyCard, ThemeSwatch, ArtistTile, AlbumTile, ArtistGrid, AlbumGrid, MenuRow, AlbumLine, TrackLine, QueueLine, LyricLine, LyricsScroll, StageLyrics, Link, HistoryLine, Heading, Tab, WaveBar, Chip, TimePart, SleepMenu, Section, Divider } from "common.slint";
export { Tip, Theme, WidgetWords, Palette, Tr, ThemeCard, ArtistRow, BrowseRow, RootRow, AlbumRow, TrackRow, QueueRow, InfoRow, TagRow, OptionRow, GraphNode, AboutRow, Words, WaveMark, EditorLine, ChapterRow, SmartRow, HealthRow, EqRow, HistoryRow, LyricRow }

export component AppWindow inherits Window {
    title: "Nyanoto";
    icon: root.app-icon;
    preferred-width: 1100px;
    preferred-height: 720px;
    // Чёт тут хуйня какая-то: Slint пересчитывает наименьший размер окна, только когда он
    // меняется в его единицах, — масштаб дёргает эту прибавку.
    in property <length> min-nudge;
    min-width: 420px + root.min-nudge;
    min-height: 460px;
    // Свой заголовок: системной рамки нет, края тянутся за полосу 6 точек.
    no-frame: true;
    resize-border-width: 6px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    in property <int> page;
    in property <string> crumb: Tr.w.artists;
    in property <bool> empty;
    in property <string> status;
    /// Доля прочитанного при сканировании; меньше нуля — полосы нет.
    in property <float> scan-progress: -1;
    in property <bool> statistics-enabled;

    in property <[ArtistRow]> artists;
    in property <[AlbumRow]> albums;
    in property <[TrackRow]> tracks;
    in property <[ArtistRow]> found-artists;
    in property <[TrackRow]> found-tracks;
    in property <[ArtistRow]> playlists;
    in property <[TrackRow]> playlist-tracks;
    in property <bool> playlist-deletable;
    in property <[TrackRow]> top-tracks;
    in property <[InfoRow]> stats-summary;
    in property <[InfoRow]> top-artists;

    in property <string> album-artist;
    in property <string> album-detail;
    in property <image> album-cover;

    // Шапка исполнителя: аватар или буква, сводка, можно ли менять аватар.
    in property <image> artist-avatar;
    in property <string> artist-letter;
    in property <string> artist-detail;
    in property <bool> artist-avatar-editable;
    in property <bool> artist-own-avatar;

    // Настройки.
    in-out property <int> language-index;
    in-out property <bool> advanced;
    in-out property <bool> statistics;
    in-out property <bool> authenticity;
    in-out property <bool> cover-cache: true;
    in-out property <bool> cover-disk: true;
    // 0 — высокое, 1 — среднее, 2 — минимальное.
    in-out property <int> cover-quality: 1;
    in-out property <bool> ffmpeg: true;
    // «О приложении»: версия, сборка, папка данных, компоненты.
    in property <string> about-version;
    in property <string> about-build;
    in property <string> about-data;
    in property <[AboutRow]> about-rows;
    in-out property <bool> about-open;
    in-out property <bool> hotkeys-open;
    // Медиаклавиши и виджет плеера системы (MPRIS в Linux, SMTC в Windows).
    in-out property <bool> system-media: true;
    // Карта прослушиваний: узлы, линии (команды SVG-пути) и размер холста.
    in property <[GraphNode]> graph-nodes;
    in property <string> graph-links;
    out property <length> graph-width;
    out property <length> graph-height;
    // 0 — карта, 1 — списки.
    in-out property <int> stats-view;
    // Состояние FFmpeg словами: найден ли, какой, откуда.
    in property <string> ffmpeg-status;
    in-out property <int> authenticity-level;
    in property <bool> checking-now;
    // Модули панели: таймер сна, повтор A–B, перемешивание — каждый отдельно.
    in-out property <bool> sleep-enabled;
    in-out property <bool> ab-enabled;
    // A–B: 0 — выключен, 1 — поставлено начало, 2 — отрезок повторяется.
    in property <int> ab-stage;
    // Перемешивание: 0 — нет, 1 — треки, 2 — альбомы.
    in property <int> shuffle-mode;
    // Кольцо вокруг луны: сколько осталось до сна (контур в квадрате 24 × 24).
    in property <string> sleep-ring;
    in-out property <bool> replaygain;
    in-out property <int> replaygain-mode;
    in-out property <bool> lyrics-enabled;
    // На сколько миллисекунд раньше подсвечивать строку текста.
    in-out property <float> lyrics-lead: 150;
    // Вид текста в настройках и тот, что сейчас на экране.
    in-out property <int> lyrics-style-index;
    // Сцены: какая (два авторежима и стили) и сколько кадров в секунду.
    in-out property <int> stage-scene-index;
    in-out property <int> stage-fps-index;
    in property <[string]> stage-scene-names;
    in property <[string]> stage-fps-names;
    // Вид текста: 0 колонка, 1 сцены.
    in property <int> lyrics-look;
    // Кадр сцены и цвета для неё (окно текста; в полноэкранном — белым по тёмному).
    in property <image> stage-frame;
    out property <color> stage-ink: Theme.foreground;
    out property <color> stage-ground: Theme.background;
    out property <color> stage-accent: Theme.accent;
    in property <string> sleep-text;
    // Таймер сна: меню (открыто ли, где кнопка), что в нём выбрано и сколько осталось.
    in-out property <bool> sleep-menu-open;
    in-out property <length> sleep-anchor;
    in property <string> sleep-hours;
    in property <string> sleep-minutes;
    in property <string> sleep-day;
    in property <string> sleep-plan;
    in property <string> sleep-arc;
    in property <float> sleep-handle-x;
    in property <float> sleep-handle-y;
    in property <float> sleep-now-x;
    in property <float> sleep-now-y;
    in property <bool> sleep-running;
    in property <bool> sleep-after-track;
    in property <string> ab-text;
    in property <bool> lyrics-open;
    // «Т»: в узком окне вернуть текст, иначе открыть или закрыть.
    function lyrics-button() {
        if (root.lyrics-open && root.narrow-window && root.lyrics-yield) {
            root.lyrics-yield = false;
        } else {
            root.lyrics-toggle();
        }
    }
    // Узкое окно: текст и страницы рядом не влезают. Ставится в `changed width`, не привязкой —
    // иначе петля.
    in-out property <bool> narrow-window;
    // Нижняя панель по ширине окна: крайние колонки равны, пока можно; лишнее сворачивается,
    // громкость гнётся.
    in-out property <length> bar-left: 330px;
    in-out property <length> bar-right: 330px;
    // Значки справа: сколько влезает; лишние — в «⋯» (первыми — главы, эквалайзер, A–B, сон).
    property <bool> chapters-on: root.long-records && root.has-track;
    property <int> tool-count: (root.lyrics-enabled ? 1 : 0) + 1 + (root.sleep-enabled ? 1 : 0) + (root.ab-enabled ? 1 : 0)
        + (root.eq-enabled ? 1 : 0) + (root.chapters-on ? 1 : 0);
    property <int> tool-slots: floor(root.bar-right / 34px);
    // Скорость — рядом с громкостью, пока обе помещаются прямыми.
    property <bool> speed-open: root.speed-enabled && root.bar-right >= 296px;
    property <bool> more-needed: (root.speed-enabled && !root.speed-open) || root.tool-count > root.tool-slots;
    property <int> tools-shown: root.more-needed ? min(root.tool-count, max(0, root.tool-slots - 1)) : root.tool-count;
    property <int> rank-queue: root.lyrics-enabled ? 1 : 0;
    property <int> rank-sleep: root.rank-queue + 1;
    property <int> rank-ab: root.rank-sleep + (root.sleep-enabled ? 1 : 0);
    property <int> rank-eq: root.rank-ab + (root.ab-enabled ? 1 : 0);
    property <int> rank-chapters: root.rank-eq + (root.eq-enabled ? 1 : 0);
    property <bool> tool-lyrics: root.tools-shown > 0;
    property <bool> tool-queue: root.rank-queue < root.tools-shown;
    property <bool> tool-sleep: root.rank-sleep < root.tools-shown;
    property <bool> tool-ab: root.rank-ab < root.tools-shown;
    property <bool> tool-eq: root.rank-eq < root.tools-shown;
    property <bool> tool-chapters: root.rank-chapters < root.tools-shown;
    // Ширина колонки текста песни — 40 % места справа от полосы разделов.
    in-out property <length> lyrics-width: 400px;
    // Место справа от полосы разделов.
    in-out property <length> pages-room: 1040px;
    // Подписи в настройках: в узком окне сжимаются вместе с ним.
    in-out property <length> label-short: 160px;
    in-out property <length> label-long: 260px;
    // Образцы тем — четыре в ряд.
    in-out property <length> swatch-width: 104px;
    // Место громкости в полном плеере.
    in-out property <length> full-volume-room: 156px;
    changed width => {
        self.narrow-window = self.width < 780px;
        self.pages-room = self.width - 60px;
        self.lyrics-width = max(260px, (self.width - 60px) * 0.4);
        self.label-short = clamp((self.width - 600px) * 0.25 + 90px, 90px, 160px);
        self.label-long = clamp((self.width - 600px) * 0.5 + 90px, 90px, 260px);
        self.swatch-width = clamp((self.width - 166px) / 4, 60px, 104px);
        self.full-volume-room = clamp(self.width - 340px, 38px, 156px);
        // Поля 24, промежутки 2 × 12, середина не уже 226.
        let free = self.width - 274px;
        let even = min(330px, free / 2);
        self.bar-left = max(106px, even);
        self.bar-right = even >= 106px ? even : max(38px, free - 106px);
    }
    // В узком окне выбрали раздел слева — показываем страницу вместо текста.
    in-out property <bool> lyrics-yield;
    property <bool> lyrics-side: root.lyrics-open && !(root.narrow-window && root.lyrics-yield);
    property <bool> lyrics-only: root.lyrics-side && root.narrow-window;
    // Колонка текста раздвигается на всё окно и сдвигается обратно плавно.
    property <float> lyrics-grow: root.lyrics-only ? 1 : 0;
    property <float> lyrics-keep: root.lyrics-side ? 1 : 0;
    animate lyrics-grow, lyrics-keep { duration: 320ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    changed lyrics-open => { root.lyrics-yield = false; }
    changed season => { Theme.decor = root.season != 0; }
    changed narrow-window => {
        if (!root.narrow-window) {
            root.lyrics-yield = false;
        }
    }
    in property <string> lyrics-title;
    in property <bool> lyrics-synced;
    in property <[LyricRow]> lyrics-lines;
    in property <string> lyrics-plain;
    in property <bool> editor-open;
    in property <string> editor-title;
    in-out property <int> editor-step;
    in-out property <string> editor-plain;
    in-out property <string> editor-raw;
    in property <[EditorLine]> editor-lines;
    in property <string> editor-position;
    in property <string> editor-summary;
    in property <string> editor-message;
    in property <bool> editor-dirty;
    in property <bool> editor-can-undo;
    in-out property <bool> editor-confirm-close;
    in-out property <int> editor-tap-offset;
    // Строка, которую список прокручивает в поле зрения.
    in property <int> editor-focus-line;
    // Играет трек из редактора, а не какой-то другой.
    in property <bool> editor-playing;
    in-out property <bool> editor-confirm-save;
    in property <string> editor-confirm-text;
    in-out property <bool> speed-enabled;
    in-out property <float> speed: 1.0;
    in property <string> speed-text;
    in-out property <bool> keep-pitch: true;
    in-out property <float> editor-speed: 1.0;
    in property <string> editor-speed-text;
    in property <image> editor-wave;
    in property <image> editor-overview;
    in property <bool> editor-wave-ready;
    in property <[WaveMark]> editor-wave-marks;
    in property <[WaveMark]> editor-overview-marks;
    in property <float> editor-overview-position;
    // Сдвиг полосы крупной волны в ширинах видимого окна.
    in property <float> editor-wave-shift;
    in-out property <bool> classical;
    in-out property <bool> tags-cp1251;
    // Окно подтверждения с предпросмотром.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <[InfoRow]> confirm-rows;
    in property <string> confirm-yes;
    in-out property <bool> long-records;
    in property <bool> chapters-open;
    in property <string> chapters-track;
    in property <[ChapterRow]> chapter-rows;
    in property <string> bookmark-time;
    in-out property <string> bookmark-name;
    in-out property <bool> smart-enabled;
    in property <bool> repeat-on;
    // Повтор: 0 — выключен, 1 — трек, 2 — альбом, плейлист или список.
    in property <int> repeat-mode;
    // Значок приложения: в заголовке окна, на панели задач и в боковой полосе.
    in property <image> app-icon;
    // Есть ли текст у играющего трека.
    in property <bool> now-lyrics;
    // Возврат сцен на обычные строки: под нагрузкой и при энергосбережении.
    in-out property <bool> stage-fallback-load: true;
    in-out property <bool> stage-fallback-power: true;
    in property <string> stage-fallback;
    // Прокрутка настроек (для проверок: в отладочной сборке её задаёт NYANOTO_SETTINGS_SCROLL).
    in-out property <length> settings-scroll;
    in property <bool> sleep-on;
    in property <bool> ab-on;
    in property <bool> shuffle-on;
    in property <string> shuffle-text;
    in property <bool> playlist-smart;
    in property <bool> playlist-daily;
    // Плейлист дня: карточка в «Плейлистах» и настройки.
    in property <int> daily-state;
    in property <string> daily-detail;
    in property <[image]> daily-covers;
    in property <string> daily-status;
    in property <bool> daily-available;
    in-out property <bool> daily-enabled;
    in-out property <int> daily-length-index: 1;
    in-out property <float> daily-fresh: 30;
    in-out property <int> daily-threshold-index: 1;
    callback daily-open();
    callback daily-play();
    callback daily-enable();
    callback daily-dismiss();
    callback daily-rebuild();
    callback daily-enabled-changed(bool);
    callback daily-length-changed(int);
    callback daily-fresh-changed(float, bool);
    callback daily-threshold-changed(int);
    in property <bool> smart-open;
    in-out property <string> smart-name;
    in-out property <int> smart-match;
    in-out property <int> smart-order;
    in-out property <string> smart-limit;
    in property <[SmartRow]> smart-conditions;
    in property <[string]> smart-kinds;
    in property <[string]> smart-orders;
    in property <[string]> smart-presets;
    in property <string> smart-message;
    in-out property <bool> health-enabled;
    in property <string> health-progress;
    in property <bool> health-busy;
    in property <[HealthRow]> health-rows;
    in-out property <bool> wavebar-enabled;
    in property <image> wavebar;
    in property <bool> wavebar-ready;
    in-out property <bool> eq-enabled;
    in-out property <bool> device-profiles;
    in property <bool> eq-open;
    in-out property <bool> eq-active;
    in-out property <float> eq-preamp;
    in property <image> eq-curve;
    in property <[EqRow]> eq-rows;
    in property <[string]> eq-profiles;
    in-out property <int> eq-profile-index;
    in-out property <string> eq-profile-name;
    in property <string> eq-message;
    in property <string> eq-device;
    in-out property <bool> crossfade;
    in-out property <int> crossfade-index: 2;
    in-out property <bool> exclusive-enabled;
    in-out property <bool> device-pause: true;
    // Рисовать видеокартой (настройка; сработает после перезапуска).
    in-out property <bool> gpu-render;
    in property <string> signal-path;
    in-out property <bool> sync-enabled;
    in property <string> sync-folder;
    in property <string> sync-status;
    in-out property <bool> convert-enabled;
    in property <bool> convert-open;
    in property <bool> convert-busy;
    in property <string> convert-count;
    in property <string> convert-folder;
    in property <string> convert-message;
    in-out property <int> convert-format;
    in-out property <int> convert-quality;
    in property <bool> warning-open;
    // Чьё предупреждение открыто: 0 — проверки подлинности, 1 — кэша обложек.
    in property <int> warning-kind;
    in-out property <bool> auto-next: true;
    in-out property <int> auto-next-order;
    in property <[RootRow]> roots;
    // Телефон: нет доступа ко всем файлам — просим его.
    in property <bool> storage-denied;
    callback storage-ask();
    // Телефон: «Назад» на главной — в фон, музыка играет дальше.
    callback leave();
    // Телефон, жест «Назад»: насколько протянули (0…1) и с какого края (0 — слева);
    // `back-possible` — есть ли куда вернуться внутри, `back-commit` — вернуться.
    in property <float> back-progress;
    in property <int> back-edge;
    callback back-possible(bool);
    callback back-commit();
    // Свой выбор папки или файла — на телефоне (на компьютере системный диалог).
    in property <bool> browse-open;
    in property <string> browse-title;
    in property <string> browse-path;
    in property <[BrowseRow]> browse-rows;
    in property <bool> browse-folder;
    callback browse-enter(int);
    callback browse-up();
    callback browse-pick();
    callback browse-close();
    // Выбрали папку — вопрос, как её раскладывать.
    in-out property <bool> folder-choice-open;
    in property <string> folder-choice-path;
    in property <[OptionRow]> future-options;

    // Панель воспроизведения.
    in property <string> now-title;
    in property <string> now-artist;
    // Та же строка по частям: исполнитель и альбом — ссылки.
    in property <string> now-owner;
    in property <string> now-album;
    // Полный плеер: открыт, на весь монитор, обложка, фон, следующий, есть ли текст.
    in-out property <bool> full-open;
    in property <bool> os-fullscreen;
    // Окно развёрнуто (кнопка «развернуть» становится «вернуть», рамки по краю нет).
    in property <bool> window-maximized;
    // Место под кнопки окна справа в верхней строке.
    property <length> window-buttons-room: 3 * 40px + 2 * 2px + 12px;
    callback window-drag();
    callback window-maximize();
    callback window-minimize();
    callback window-close();
    callback window-menu(length, length);
    in property <image> full-cover;
    // Полноэкранный плеер ещё виден (уезжает после закрытия).
    in-out property <bool> full-shown;
    // Полный плеер закрывает окно — страницы под ним не рисуются. Тянут вниз или
    // сворачивается — снова видны.
    property <bool> full-covers: root.full-shown && root.full-open && !root.full-dragging;
    // Стрелка жеста: 1 назад, 2 вперёд, 3 следующий, 4 предыдущий; место: 0 страница,
    // 1 панель, 2 полный плеер.
    in property <int> swipe-kind;
    in property <int> swipe-place;
    in property <float> swipe-progress;
    in property <bool> swiping;
    in property <length> full-drag;
    in property <bool> full-dragging;
    in property <length> full-shift;
    // Правый край трека в панели: над ним жесты — по треку.
    out property <length> bar-track-right: bar-track.absolute-position.x + bar-track.width;
    in-out property <bool> gestures-enabled: true;
    // Оформление: тема, сезонные темы, масштаб.
    in-out property <int> theme-index: 1;
    // Образцы тем — в два ряда.
    in property <[ThemeCard]> theme-cards;
    in property <[ThemeCard]> theme-cards-more;
    in-out property <bool> seasons-enabled: true;
    in property <string> season-note;
    in-out property <float> scale-percent: 100;
    // Сезон: 0 — нет; сценка, что идёт сейчас (0 — никакой), и сколько их было.
    in property <int> season;
    in property <int> season-episode;
    in-out property <int> season-episode-count;
    // ВРЕМЕННО: предпросмотр праздников.
    in property <[string]> season-preview-names;
    in-out property <int> season-preview-index;
    callback season-preview(int);
    callback season-play();
    callback theme-changed(int);
    callback seasons-changed(bool);
    callback scale-changed(float, bool);
    callback zoom(int);
    callback gestures-enabled-changed(bool);
    // Сколько держать плеер, пока сворачивается.
    in property <duration> full-close-time: 420ms;
    in property <image> full-background;
    in property <string> full-next;
    in property <bool> full-lyrics;
    // Страница очереди: 0 — «Дальше», 1 — «История».
    in-out property <int> queue-tab;
    in property <[HistoryRow]> history-rows;
    in property <string> now-quality;
    in property <string> now-badge;
    in property <int> now-badge-kind;
    in property <bool> now-badge-clickable;
    in property <bool> now-liked;
    in property <bool> has-track;
    in property <image> now-cover;
    in property <bool> playing;
    in-out property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <bool> seeking;
    in-out property <float> volume: 1.0;
    in property <string> repeat-text: "";
    in-out property <string> query;

    // Окно сведений о треке.
    in property <bool> info-open;
    in property <string> info-title;
    in property <string> info-quality;
    in property <string> info-badge;
    in property <int> info-badge-kind;
    in property <[InfoRow]> info-rows;
    in property <[TagRow]> info-tags;
    in property <string> info-tag-kind;
    in property <bool> info-editable;
    in property <bool> info-dirty;
    in property <bool> info-can-undo;
    in property <string> info-message;
    in-out property <bool> info-confirm;

    // Окно подлинности качества.
    in property <bool> quality-open;
    in property <string> quality-title;
    in property <string> quality-claim;
    in property <string> quality-reason;
    in property <string> quality-detected;
    in property <bool> quality-overridden;
    in-out property <int> quality-label-index;

    // Выбор плейлиста.
    in property <bool> picker-open;
    // В окне «+» есть пункты очереди (их нет, когда в плейлист сохраняется сама очередь).
    in property <bool> picker-queue-options: true;
    in property <[QueueRow]> queue-rows;
    in property <string> queue-summary;
    in property <int> queue-count;
    in-out property <string> new-playlist-name;

    callback search(string);
    callback back();
    callback go(int);
    callback open-artist(int);
    // Вид исполнителей и альбомов: сеткой (по умолчанию) или списком.
    in-out property <bool> artists-grid: true;
    in-out property <bool> albums-grid: true;
    // 0 — исполнители, 1 — альбомы; true — сеткой.
    callback view-changed(int, bool);
    // Плитка исполнителя появилась на экране: догрузить картинку.
    callback artist-tile-shown(int);
    callback open-found-artist(int);
    callback open-album(int);
    callback play-album();
    callback choose-avatar();
    callback remove-avatar();
    callback track-clicked(int, int);
    callback track-like(int, int);
    callback track-add(int, int);
    callback track-info(int, int);
    callback track-remove(int, int);
    callback open-playlist(int);
    callback create-playlist(string);
    callback delete-playlist();
    callback play-playlist();
    callback toggle();
    callback next();
    callback previous();
    // Горячая клавиша: текст нажатия, Ctrl, Shift; `true` — нажатие обработано.
    callback hotkey(string, bool, bool) -> bool;
    // Очередь и «+».
    callback system-media-changed(bool);
    callback queue-open();
    callback queue-tab-changed(int);
    callback history-play(int);
    callback history-clear();
    callback open-now-artist();
    callback open-now-album();
    callback full-toggle();
    callback full-warmup();
    callback toggle-fullscreen();
    callback add-current();
    callback queue-jump(int);
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();
    callback queue-save();
    callback picker-queue(bool);
    callback queue-album();
    callback queue-playlist();
    callback seek(float);
    callback set-volume(float);
    callback cycle-repeat();
    callback mute-toggle();
    callback stage-fallback-load-changed(bool);
    callback stage-fallback-power-changed(bool);
    callback like-current();
    callback info-current();
    callback add-folder();
    callback remove-folder(int);
    callback rescan();
    callback language-changed(int);
    callback folder-choice(int);
    callback root-grouping-changed(int, int);
    callback advanced-changed(bool);
    callback statistics-changed(bool);
    callback authenticity-changed(bool);
    callback cover-cache-changed(bool);
    callback cover-disk-changed(bool);
    callback cover-quality-changed(int);
    callback ffmpeg-changed(bool);
    callback stats-view-changed(int);
    // Узел взяли, тянут и отпустили; координаты — точка мыши на холсте.
    callback graph-grab(int, float, float);
    callback graph-drag(int, float, float);
    callback graph-release(int);
    callback authenticity-level-changed(int);
    callback check-now();
    callback sleep-enabled-changed(bool);
    callback ab-enabled-changed(bool);
    callback replaygain-changed(bool);
    callback replaygain-mode-changed(int);
    callback lyrics-changed(bool);
    callback sleep-cycle();
    callback sleep-step(int, int);
    callback sleep-dial(float, float, bool);
    callback sleep-wheel(int);
    callback sleep-start();
    callback sleep-stop();
    callback sleep-after-toggle();
    callback ab-cycle();
    callback lyrics-toggle();
    // Новый сдвиг строки; `true` — ползунок отпустили, пора сохранить.
    callback lyrics-lead-changed(float, bool);
    callback lyrics-style-changed(int);
    callback stage-scene-changed(int);
    callback stage-fps-changed(int);
    callback stage-resized(int, length, length);
    callback lyrics-close();
    // Нажали на строку колонки (номер строки текста).
    callback lyrics-seek(int);
    callback lyrics-edit();
    callback info-lyrics();
    callback editor-go(int);
    callback editor-plain-edited(string);
    callback editor-raw-edited(string);
    callback editor-stamp();
    callback editor-unstamp();
    callback editor-play-pause();
    callback editor-seek-by(int);
    callback editor-move(int);
    callback editor-select(int);
    callback editor-nudge(int, int);
    callback editor-set-time(int, string);
    callback editor-play-line(int);
    callback editor-clear-line(int);
    callback editor-shift-all(int);
    callback editor-tap-offset-changed(int);
    callback editor-save();
    callback editor-undo();
    callback editor-close(bool);
    callback editor-write();
    callback speed-module-changed(bool);
    callback keep-pitch-changed(bool);
    callback speed-changed(float);
    callback speed-released(float);
    callback speed-reset();
    callback editor-speed-changed(float);
    callback editor-speed-released(float);
    callback editor-overview-seek(float);
    callback editor-wave-seek(float);
    callback editor-drag(bool);
    callback editor-mark-dropped(int, float);
    callback classical-changed(bool);
    callback tags-cp1251-changed(bool);
    callback confirm-accept();
    callback confirm-cancel();
    callback long-records-changed(bool);
    callback chapters-toggle();
    callback chapters-close();
    callback chapter-jump(int);
    callback bookmark-add(string);
    callback bookmark-delete(int);
    callback smart-enabled-changed(bool);
    callback shuffle-cycle();
    callback shuffle-all();
    callback smart-new();
    callback smart-edit();
    callback smart-preset(int);
    callback smart-add-condition();
    callback smart-remove-condition(int);
    callback smart-kind-changed(int, int);
    callback smart-value-edited(int, string);
    callback smart-changed();
    callback smart-save();
    callback smart-close();
    callback health-enabled-changed(bool);
    callback health-now();
    callback health-open(int);
    callback wavebar-enabled-changed(bool);
    callback eq-enabled-changed(bool);
    callback device-profiles-changed(bool);
    callback eq-toggle();
    callback eq-close();
    callback eq-active-changed(bool);
    callback eq-preamp-changed(float);
    callback eq-kind-changed(int, int);
    callback eq-freq-edited(int, string);
    callback eq-gain-changed(int, float);
    callback eq-q-edited(int, string);
    callback eq-add();
    callback eq-remove(int);
    callback eq-reset();
    callback eq-profile-chosen(int);
    callback eq-profile-save(string);
    callback eq-profile-delete();
    callback eq-import();
    callback crossfade-changed(bool);
    callback crossfade-index-changed(int);
    callback exclusive-enabled-changed(bool);
    callback device-pause-changed(bool);
    callback gpu-render-changed(bool);
    callback daily-force();
    callback sync-enabled-changed(bool);
    callback sync-choose();
    callback sync-now();
    callback convert-enabled-changed(bool);
    callback convert-album();
    callback convert-playlist();
    callback convert-choose();
    callback convert-start();
    callback convert-stop();
    callback convert-close();
    callback warning-confirm();
    callback warning-cancel();
    callback auto-next-changed(bool);
    callback auto-next-order-changed(int);
    callback track-badge(int, int);
    callback badge-current();
    callback quality-replace(int);
    callback quality-use-detected();
    callback quality-accept();
    callback quality-reset();
    callback quality-close();
    callback info-close();
    callback tag-key-edited(int, string);
    callback tag-value-edited(int, string);
    callback tag-add();
    callback tag-remove(int);
    callback tags-save();
    callback tags-reset();
    callback tags-undo();
    callback picker-choose(int);
    callback picker-create(string);
    callback picker-close();

    // Вернуть клавиши окну (после закрытия полноэкранного плеера).
    callback focus-keys();
    focus-keys => { keys.focus(); }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.convert-open) {
                    root.convert-close();
                } else if (root.eq-open) {
                    root.eq-close();
                } else if (root.smart-open) {
                    root.smart-close();
                } else if (root.chapters-open) {
                    root.chapters-close();
                } else if (root.confirm-open) {
                    root.confirm-cancel();
                } else if (root.editor-open) {
                    root.editor-close(false);
                } else if (root.warning-open) {
                    root.warning-cancel();
                } else if (root.lyrics-open) {
                    root.lyrics-close();
                } else if (root.quality-open) {
                    root.quality-close();
                } else if (root.info-open) {
                    root.info-close();
                } else if (root.picker-open) {
                    root.picker-close();
                } else if (root.full-open) {
                    root.full-toggle();
                } else {
                    root.back();
                }
                // Фокус уходит из поля ввода: снова работают горячие клавиши.
                keys.focus();
                return accept;
            }
            // Сюда доходит только то, что не забрало поле ввода. Масштаб: Ctrl и «+», «−», «0».
            if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                root.zoom(1);
                return accept;
            }
            if (event.modifiers.control && (event.text == "-" || event.text == "_")) {
                root.zoom(-1);
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.zoom(0);
                return accept;
            }
            if ((event.modifiers.control && (event.text == "f" || event.text == "F")) || event.text == "/") {
                search-box.focus();
                return accept;
            }
            if (root.hotkey(event.text, event.modifiers.control, event.modifiers.shift)) {
                return accept;
            }
            return reject;
        }

        // Сезонные украшения — под страницами, на пустом фоне.
        if root.season != 0: SeasonDecor {
            x: 60px;
            y: 0px;
            width: root.width - 60px;
            height: root.height - 92px;
            season: root.season;
        }
        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                // Разделы — полоса значков слева.
                Rectangle {
                    width: 60px;
                    visible: !root.full-covers;
                    background: Theme.panel;
                    VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 8px;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                // За значок тоже можно тащить окно.
                                DragArea {
                                    drag => { root.window-drag(); }
                                    toggle => { root.window-maximize(); }
                                    menu(x, y) => { root.window-menu(x, y); }
                                }
                                Image {
                                    width: 34px;
                                    height: 34px;
                                    source: root.app-icon;
                                    accessible-role: image;
                                    accessible-label: "Nyanoto";
                                }
                                if root.season != 0: SeasonBadge {
                                    x: parent.width - 13px;
                                    y: -5px;
                                    season: root.season;
                                }
                            }
                        }
                        NavItem {
                            icon: Icons.music;
                            label: Tr.w.music;
                            selected: root.page <= 3;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(0);
                            }
                        }
                        NavItem {
                            icon: Icons.playlists;
                            label: Tr.w.playlists;
                            selected: root.page == 4 || root.page == 5;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(4);
                            }
                        }
                        if root.statistics-enabled: NavItem {
                            icon: Icons.statistics;
                            label: Tr.w.statistics;
                            selected: root.page == 6;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(6);
                            }
                        }
                        if root.health-enabled: NavItem {
                            icon: Icons.health;
                            label: Tr.w.health-tab;
                            selected: root.page == 8;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(8);
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        NavItem {
                            icon: Icons.folder;
                            label: Tr.w.folders-title;
                            selected: root.page == 10;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(10);
                            }
                        }
                        NavItem {
                            icon: Icons.settings;
                            label: Tr.w.settings;
                            selected: root.page == 7;
                            clicked => {
                                root.lyrics-yield = true;
                                root.go(7);
                            }
                        }
                    }
                }
                // Страницы. Не пересоздаются, когда их закрывает текст песни.
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0;
                    preferred-width: 0;
                    // Текст раздвинулся на всё окно — страницы не рисуем.
                    visible: !root.full-covers && !(root.lyrics-open && root.lyrics-grow > 0.99);
                    opacity: 1 - root.lyrics-grow;
                    clip: true;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        // Где мы и поиск. Пустое место — заголовок окна, справа место под кнопки окна.
                        Rectangle {
                            height: 54px;
                            DragArea {
                                drag => { root.window-drag(); }
                                toggle => { root.window-maximize(); }
                                menu(x, y) => { root.window-menu(x, y); }
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: root.lyrics-open && root.lyrics-keep > 0.01 ? 12px : root.window-buttons-room;
                                padding-top: 8px;
                                spacing: 8px;
                                height: 54px;
                                if root.page == 1 || root.page == 2 || root.page == 3 || root.page == 5 || root.page == 9: VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: Icons.back;
                                        label: Tr.w.back;
                                        clicked => { root.back(); }
                                    }
                                }
                                Text {
                                    text: root.crumb;
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if (root.page == 0 && !root.empty) || root.page == 1: VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        property <bool> grid: root.page == 0 ? root.artists-grid : root.albums-grid;
                                        icon: self.grid ? Icons.list : Icons.grid;
                                        label: self.grid ? Tr.w.view-list : Tr.w.view-grid;
                                        clicked => {
                                            if (root.page == 0) {
                                                root.artists-grid = !root.artists-grid;
                                                root.view-changed(0, root.artists-grid);
                                            } else {
                                                root.albums-grid = !root.albums-grid;
                                                root.view-changed(1, root.albums-grid);
                                            }
                                        }
                                    }
                                }
                                if root.page == 0 && !root.empty: VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: Icons.shuffle;
                                        label: Tr.w.shuffle-all;
                                        clicked => { root.shuffle-all(); }
                                    }
                                }
                                // Поиск сужается с окном.
                                VerticalLayout {
                                    alignment: center;
                                    search-box := LineEdit {
                                        min-width: 120px;
                                        preferred-width: clamp(root.pages-room - 340px, 120px, 320px);
                                        accessible-label: Tr.w.search-placeholder;
                                        placeholder-text: Tr.w.search-placeholder;
                                        text <=> root.query;
                                        edited(text) => { root.search(text); }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            if root.empty && root.page == 0: Appear {
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Text {
                                        text: Tr.w.library-empty;
                                        font-size: 18px;
                                        color: Theme.foreground;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Button {
                                            text: Tr.w.choose-folder;
                                            clicked => { root.add-folder(); }
                                        }
                                    }
                                }
                            }

                            if !root.empty && root.page == 0 && !root.artists-grid: Appear {
                                ListView {
                                    for row[index] in root.artists: ArtistLine {
                                        data: row;
                                        clicked => { root.open-artist(index); }
                                    }
                                }
                            }

                            // Сеткой.
                            if !root.empty && root.page == 0 && root.artists-grid: Appear {
                                ArtistGrid {
                                    rows: root.artists;
                                    open(index) => { root.open-artist(index); }
                                    shown(index) => { root.artist-tile-shown(index); }
                                }
                            }

                            if root.page == 1: Appear {
                                VerticalLayout {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 4px;
                                        spacing: 18px;
                                        height: 116px;
                                        Cover {
                                            width: 96px;
                                            height: 96px;
                                            border-radius: 48px;
                                            letter: root.artist-letter;
                                            source: root.artist-avatar;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: root.artist-detail;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.6;
                                                overflow: elide;
                                            }
                                            if root.artist-avatar-editable: HorizontalLayout {
                                                alignment: start;
                                                padding-top: 6px;
                                                spacing: 8px;
                                                Button {
                                                    text: Tr.w.avatar-choose;
                                                    clicked => { root.choose-avatar(); }
                                                }
                                                if root.artist-own-avatar: Button {
                                                    text: Tr.w.avatar-remove;
                                                    clicked => { root.remove-avatar(); }
                                                }
                                            }
                                        }
                                    }
                                    if !root.albums-grid: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.albums: AlbumLine {
                                            data: row;
                                            clicked => { root.open-album(index); }
                                        }
                                    }
                                    if root.albums-grid: AlbumGrid {
                                        vertical-stretch: 1;
                                        rows: root.albums;
                                        open(index) => { root.open-album(index); }
                                    }
                                }
                            }

                            if root.page == 2: Appear {
                                VerticalLayout {
                                    HorizontalLayout {
                                        padding: 16px;
                                        padding-top: 4px;
                                        spacing: 18px;
                                        height: 140px;
                                        Cover {
                                            width: 120px;
                                            height: 120px;
                                            source: root.album-cover;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: root.album-artist;
                                                font-size: 15px;
                                                color: Theme.foreground;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.album-detail;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.6;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                padding-top: 6px;
                                                spacing: 8px;
                                                MediaButton {
                                                    kind: 0;
                                                    primary: true;
                                                    label: Tr.w.play-album;
                                                    clicked => { root.play-album(); }
                                                }
                                                IconButton {
                                                    icon: Icons.queue-add;
                                                    label: Tr.w.add-to-queue;
                                                    clicked => { root.queue-album(); }
                                                }
                                                if root.convert-enabled: IconButton {
                                                    icon: Icons.convert;
                                                    label: Tr.w.convert-button;
                                                    clicked => { root.convert-album(); }
                                                }
                                            }
                                        }
                                    }
                                    ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.tracks: TrackLine {
                                            data: row;
                                            clicked => { root.track-clicked(0, index); }
                                            like => { root.track-like(0, index); }
                                            add => { root.track-add(0, index); }
                                            info => { root.track-info(0, index); }
                                            badge => { root.track-badge(0, index); }
                                        }
                                    }
                                }
                            }

                            if root.page == 3: Appear {
                                VerticalLayout {
                                    if root.found-artists.length > 0: HorizontalLayout {
                                        padding-left: 16px;
                                        height: 24px;
                                        Heading { text: Tr.w.artists; }
                                    }
                                    if root.found-artists.length > 0: ListView {
                                        height: min(root.found-artists.length, 3) * 52px;
                                        vertical-stretch: 0;
                                        for row[index] in root.found-artists: ArtistLine {
                                            data: row;
                                            clicked => { root.open-found-artist(index); }
                                        }
                                    }
                                    if root.found-tracks.length > 0: HorizontalLayout {
                                        padding-left: 16px;
                                        padding-top: 6px;
                                        height: 30px;
                                        Heading { text: Tr.w.tracks; }
                                    }
                                    if root.found-tracks.length > 0: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.found-tracks: TrackLine {
                                            data: row;
                                            clicked => { root.track-clicked(1, index); }
                                            like => { root.track-like(1, index); }
                                            add => { root.track-add(1, index); }
                                            info => { root.track-info(1, index); }
                                            badge => { root.track-badge(1, index); }
                                        }
                                    }
                                    if root.found-artists.length == 0 && root.found-tracks.length == 0: Text {
                                        text: Tr.w.nothing-found;
                                        color: Theme.foreground;
                                        opacity: 0.6;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        vertical-stretch: 1;
                                    }
                                }
                            }

                            if root.page == 4: Appear {
                                VerticalLayout {
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        height: 44px;
                                        LineEdit {
                                            placeholder-text: Tr.w.new-playlist-name;
                                            text <=> root.new-playlist-name;
                                            accepted(text) => { root.create-playlist(text); }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.plus;
                                                label: Tr.w.create;
                                                clicked => { root.create-playlist(root.new-playlist-name); }
                                            }
                                        }
                                        if root.smart-enabled: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.sparkle;
                                                label: Tr.w.new-smart;
                                                clicked => { root.smart-new(); }
                                            }
                                        }
                                    }
                                    if root.daily-state != 0: HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-bottom: 6px;
                                        DailyCard {
                                            state: root.daily-state;
                                            detail: root.daily-detail;
                                            covers: root.daily-covers;
                                            open => { root.daily-open(); }
                                            play => { root.daily-play(); }
                                            enable => { root.daily-enable(); }
                                            dismiss => { root.daily-dismiss(); }
                                            advanced: root.advanced;
                                            force => { root.daily-force(); }
                                        }
                                    }
                                    ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.playlists: ArtistLine {
                                            data: row;
                                            clicked => { root.open-playlist(index); }
                                        }
                                    }
                                }
                            }

                            if root.page == 5: Appear {
                                VerticalLayout {
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        height: 44px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            MediaButton {
                                                kind: 0;
                                                primary: true;
                                                label: Tr.w.play;
                                                clicked => { root.play-playlist(); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.queue-add;
                                                label: Tr.w.add-to-queue;
                                                enabled: root.playlist-tracks.length > 0;
                                                clicked => { root.queue-playlist(); }
                                            }
                                        }
                                        if root.convert-enabled: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.convert;
                                                label: Tr.w.convert-button;
                                                enabled: root.playlist-tracks.length > 0;
                                                clicked => { root.convert-playlist(); }
                                            }
                                        }
                                        if root.playlist-smart: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.rules;
                                                label: Tr.w.edit-rules;
                                                clicked => { root.smart-edit(); }
                                            }
                                        }
                                        if root.playlist-daily: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.refresh;
                                                label: Tr.w.daily-rebuild;
                                                enabled: root.daily-state != 2;
                                                clicked => { root.daily-rebuild(); }
                                            }
                                        }
                                        if root.playlist-deletable: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.trash;
                                                label: Tr.w.delete-playlist;
                                                clicked => { root.delete-playlist(); }
                                            }
                                        }
                                    }
                                    // Порядок решает пользователь: при перемешивании — только подсказка.
                                    if root.playlist-daily && root.shuffle-mode != 0 && root.playlist-tracks.length > 0: HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-bottom: 4px;
                                        Text {
                                            text: Tr.w.daily-shuffled;
                                            font-size: 12px;
                                            color: Theme.foreground;
                                            opacity: 0.6;
                                            wrap: word-wrap;
                                        }
                                    }
                                    if root.playlist-tracks.length == 0: Text {
                                        text: root.playlist-daily ? root.daily-detail : Tr.w.playlist-empty;
                                        color: Theme.foreground;
                                        opacity: 0.6;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        vertical-stretch: 1;
                                    }
                                    if root.playlist-tracks.length > 0: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.playlist-tracks: TrackLine {
                                            data: row;
                                            removable: !root.playlist-smart && !root.playlist-daily;
                                            clicked => { root.track-clicked(2, index); }
                                            like => { root.track-like(2, index); }
                                            add => { root.track-add(2, index); }
                                            info => { root.track-info(2, index); }
                                            badge => { root.track-badge(2, index); }
                                            remove => { root.track-remove(2, index); }
                                        }
                                    }
                                }
                            }

                            // Очередь: что играет, что уже сыграно и что будет дальше.
                            if root.page == 9: Appear {
                                VerticalLayout {
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        spacing: 4px;
                                        alignment: start;
                                        Tab {
                                            text: Tr.w.queue-next;
                                            selected: root.queue-tab == 0;
                                            clicked => {
                                                root.queue-tab = 0;
                                                root.queue-tab-changed(0);
                                            }
                                        }
                                        Tab {
                                            text: Tr.w.history;
                                            selected: root.queue-tab == 1;
                                            clicked => {
                                                root.queue-tab = 1;
                                                root.queue-tab-changed(1);
                                            }
                                        }
                                    }
                                    if root.queue-tab == 1 && root.history-rows.length > 0: HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        height: 44px;
                                        alignment: end;
                                        VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.trash;
                                                label: Tr.w.history-clear;
                                                clicked => { root.history-clear(); }
                                            }
                                        }
                                    }
                                    if root.queue-tab == 1 && root.history-rows.length == 0: Text {
                                        text: Tr.w.history-empty;
                                        wrap: word-wrap;
                                        color: Theme.foreground;
                                        opacity: 0.6;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        vertical-stretch: 1;
                                    }
                                    if root.queue-tab == 1 && root.history-rows.length > 0: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.history-rows: HistoryLine {
                                            data: row;
                                            clicked => { root.history-play(index); }
                                        }
                                    }
                                    if root.queue-tab == 0: HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        height: 44px;
                                        Text {
                                            text: root.queue-summary;
                                            color: Theme.foreground;
                                            opacity: 0.7;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if root.queue-rows.length > 0: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.save;
                                                label: Tr.w.queue-save;
                                                clicked => { root.queue-save(); }
                                            }
                                        }
                                        if root.queue-rows.length > 0: VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: Icons.trash;
                                                label: Tr.w.queue-clear;
                                                clicked => { root.queue-clear(); }
                                            }
                                        }
                                    }
                                    if root.queue-tab == 0 && root.queue-rows.length == 0: Text {
                                        text: Tr.w.queue-empty;
                                        wrap: word-wrap;
                                        color: Theme.foreground;
                                        opacity: 0.6;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        vertical-stretch: 1;
                                    }
                                    if root.queue-tab == 0 && root.queue-rows.length > 0: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.queue-rows: QueueLine {
                                            data: row;
                                            first: index == 0;
                                            last: index == root.queue-rows.length - 1;
                                            clicked => { root.queue-jump(index); }
                                            up => { root.queue-move(index, -1); }
                                            down => { root.queue-move(index, 1); }
                                            remove => { root.queue-remove(index); }
                                        }
                                    }
                                }
                            }

                            if root.page == 8: Appear {
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 36px;
                                        Text {
                                            text: root.health-progress;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            color: Theme.foreground;
                                        }
                                        Button {
                                            text: Tr.w.check-now;
                                            enabled: !root.health-busy;
                                            clicked => { root.health-now(); }
                                        }
                                    }
                                    ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.health-rows: Rectangle {
                                            height: row.heading ? 36px : 42px;
                                            if row.heading: Text {
                                                x: 0;
                                                text: row.text;
                                                font-size: 15px;
                                                font-weight: 700;
                                                vertical-alignment: bottom;
                                                color: Theme.foreground;
                                            }
                                            if !row.heading: Line {
                                                label: row.text;
                                                clicked => { root.health-open(index); }
                                                VerticalLayout {
                                                    padding-left: 8px;
                                                    alignment: center;
                                                    Text {
                                                        text: row.text;
                                                        overflow: elide;
                                                        color: Theme.foreground;
                                                    }
                                                    if row.detail != "": Text {
                                                        text: row.detail;
                                                        font-size: 11px;
                                                        overflow: elide;
                                                        color: Theme.foreground;
                                                        opacity: 0.6;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.page == 6: Appear {
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 6px;
                                    for row in root.stats-summary: HorizontalLayout {
                                        Text {
                                            text: row.name;
                                            width: 220px;
                                            color: Theme.foreground;
                                            opacity: 0.7;
                                        }
                                        Text {
                                            text: row.value;
                                            color: Theme.foreground;
                                        }
                                    }
                                    if root.graph-nodes.length > 0: HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        Tab {
                                            text: Tr.w.graph-map;
                                            selected: root.stats-view == 0;
                                            clicked => {
                                                root.stats-view = 0;
                                                root.stats-view-changed(0);
                                            }
                                        }
                                        Tab {
                                            text: Tr.w.graph-lists;
                                            selected: root.stats-view == 1;
                                            clicked => {
                                                root.stats-view = 1;
                                                root.stats-view-changed(1);
                                            }
                                        }
                                    }
                                    if root.graph-nodes.length > 0 && root.stats-view == 0: Text {
                                        text: Tr.w.graph-hint;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                        color: Theme.foreground;
                                        opacity: 0.6;
                                    }
                                    // Карта: узлы-круги поверх одного пути со всеми линиями.
                                    if root.graph-nodes.length > 0 && root.stats-view == 0: Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 200px;
                                        clip: true;
                                        border-radius: Ui.radius-large;
                                        background: Theme.surface;
                                        init => {
                                            root.graph-width = self.width;
                                            root.graph-height = self.height;
                                        }
                                        changed width => { root.graph-width = self.width; }
                                        changed height => { root.graph-height = self.height; }
                                        Path {
                                            width: parent.width;
                                            height: parent.height;
                                            viewbox-width: self.width / 1px;
                                            viewbox-height: self.height / 1px;
                                            commands: root.graph-links;
                                            stroke: Theme.foreground;
                                            stroke-width: 1px;
                                            opacity: 0.25;
                                        }
                                        for node[index] in root.graph-nodes: Rectangle {
                                            x: (node.x - node.r) * 1px;
                                            y: (node.y - node.r) * 1px;
                                            width: node.r * 2px;
                                            height: node.r * 2px;
                                            // Исполнитель — круг, альбом — квадрат.
                                            border-radius: node.artist ? self.width / 2 : 2px;
                                            background: node.image.width > 0 ? transparent : node.color;
                                            Image {
                                                width: 100%;
                                                height: 100%;
                                                source: node.image;
                                                image-fit: fill;
                                            }
                                            if node.artist && node.image.width == 0: Text {
                                                width: 100%;
                                                height: 100%;
                                                text: node.letter;
                                                font-size: max(9px, parent.height * 0.42);
                                                font-weight: 600;
                                                color: #ffffffd8;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            touch := TouchArea {
                                                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.down) {
                                                        root.graph-grab(index, node.x - node.r + self.mouse-x / 1px, node.y - node.r + self.mouse-y / 1px);
                                                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                                        root.graph-release(index);
                                                    }
                                                }
                                                moved => {
                                                    root.graph-drag(index, node.x - node.r + self.mouse-x / 1px, node.y - node.r + self.mouse-y / 1px);
                                                }
                                            }
                                            // Название альбома — при наведении, на подложке: под ним бывают обложки.
                                            if !node.artist && touch.has-hover: Rectangle {
                                                x: (parent.width - self.width) / 2;
                                                y: parent.height + 2px;
                                                width: hover-label.preferred-width + 8px;
                                                height: hover-label.preferred-height + 2px;
                                                border-radius: Ui.radius-small;
                                                background: Theme.background.with-alpha(0.85);
                                                hover-label := Text {
                                                    text: node.label;
                                                    font-size: 11px;
                                                    color: Theme.foreground;
                                                }
                                            }
                                        }
                                        // Имена исполнителей — отдельным слоем поверх кругов, чтобы их не закрывали альбомы.
                                        for node in root.graph-nodes: Text {
                                            visible: node.artist;
                                            x: node.x * 1px - self.width / 2;
                                            y: (node.y + node.r) * 1px + 2px;
                                            text: node.label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                    }
                                    if (root.graph-nodes.length == 0 || root.stats-view == 1) && root.top-artists.length > 0: Heading { text: Tr.w.artists; }
                                    if root.graph-nodes.length == 0 || root.stats-view == 1: VerticalLayout {
                                        spacing: 6px;
                                        for row in root.top-artists: HorizontalLayout {
                                            Text {
                                                text: row.name;
                                                width: 320px;
                                                color: Theme.foreground;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.value;
                                                color: Theme.foreground;
                                                opacity: 0.7;
                                            }
                                        }
                                    }
                                    if (root.graph-nodes.length == 0 || root.stats-view == 1) && root.top-tracks.length > 0: Heading { text: Tr.w.tracks; }
                                    if root.graph-nodes.length == 0 || root.stats-view == 1: ListView {
                                        vertical-stretch: 1;
                                        for row[index] in root.top-tracks: TrackLine {
                                            data: row;
                                            clicked => { root.track-clicked(3, index); }
                                            like => { root.track-like(3, index); }
                                            add => { root.track-add(3, index); }
                                            info => { root.track-info(3, index); }
                                            badge => { root.track-badge(3, index); }
                                        }
                                    }
                                }
                            }

                            // Папки с музыкой — своей страницей.
                            if root.page == 10: Appear {
                                ScrollView {
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-top: 0px;
                                        spacing: 12px;
                                        alignment: start;
                                        Section {
                                            title: Tr.w.folders-title;
                                            Text {
                                                text: Tr.w.folders;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.6;
                                            }
                                            for folder[index] in root.roots: HorizontalLayout {
                                                spacing: 10px;
                                                Text {
                                                    text: folder.path;
                                                    color: Theme.foreground;
                                                    opacity: 0.8;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                                // Раскладка этой папки.
                                                VerticalLayout {
                                                    alignment: center;
                                                    ComboBox {
                                                        width: 170px;
                                                        model: root.classical ? [Tr.w.by-folders, Tr.w.by-tags, Tr.w.by-composers] : [Tr.w.by-folders, Tr.w.by-tags];
                                                        current-index: folder.grouping;
                                                        selected(value) => { root.root-grouping-changed(index, self.current-index); }
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    IconButton {
                                                        icon: Icons.trash;
                                                        label: Tr.w.remove-folder;
                                                        clicked => { root.remove-folder(index); }
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Button {
                                                    text: Tr.w.add-folder;
                                                    clicked => { root.add-folder(); }
                                                }
                                                Button {
                                                    text: Tr.w.rescan;
                                                    clicked => { root.rescan(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.page == 7: Appear {
                                ScrollView {
                                    content-y <=> root.settings-scroll;
                                    VerticalLayout {
                                        padding: 16px;
                                        padding-top: 0px;
                                        spacing: 10px;
                                        alignment: start;

                                        Section {
                                            title: Tr.w.about;
                                            Text {
                                                text: root.about-version;
                                                font-size: 16px;
                                                font-weight: 700;
                                                color: Theme.foreground;
                                            }
                                            Divider {}
                                            Text {
                                                text: root.about-build;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.7;
                                            }
                                            Divider {}
                                            Text {
                                                text: root.about-data;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.7;
                                            }
                                            Divider {}
                                            Text {
                                                text: Tr.w.about-slint;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.7;
                                            }
                                            Divider {}
                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    text: root.about-open ? Tr.w.about-hide : Tr.w.about-components;
                                                    clicked => { root.about-open = !root.about-open; }
                                                }
                                            }
                                            Divider {}
                                            if root.about-open: VerticalLayout {
                                                spacing: 4px;
                                                for row in root.about-rows: HorizontalLayout {
                                                    spacing: 10px;
                                                    Text {
                                                        text: row.name;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        color: Theme.foreground;
                                                    }
                                                    Text {
                                                        text: row.version;
                                                        min-width: 90px;
                                                        color: Theme.foreground;
                                                    }
                                                    Text {
                                                        text: row.license;
                                                        min-width: 150px;
                                                        overflow: elide;
                                                        color: Theme.foreground;
                                                        opacity: 0.6;
                                                    }
                                                }
                                            }
                                        }
                                        Section {
                                            title: Tr.w.section-look;
                                            Text {
                                                text: Tr.w.theme;
                                                color: Theme.foreground;
                                            }
                                            // Образцы в два ряда: так они помещаются и в узком окне.
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;
                                                for card[index] in root.theme-cards: ThemeSwatch {
                                                    side: root.swatch-width;
                                                    data: card;
                                                    selected: index == root.theme-index;
                                                    clicked => {
                                                        root.theme-index = index;
                                                        root.theme-changed(index);
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;
                                                for card[index] in root.theme-cards-more: ThemeSwatch {
                                                    side: root.swatch-width;
                                                    data: card;
                                                    selected: index + root.theme-cards.length == root.theme-index;
                                                    clicked => {
                                                        root.theme-index = index + root.theme-cards.length;
                                                        root.theme-changed(root.theme-index);
                                                    }
                                                }
                                            }
                                            Divider {}
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Switch {
                                                    checked <=> root.seasons-enabled;
                                                    accessible-label: Tr.w.seasons;
                                                    enabled: false;
                                                    toggled => { root.seasons-changed(self.checked); }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: start;
                                                        Text {
                                                            text: Tr.w.seasons;
                                                            color: Theme.foreground;
                                                            opacity: 0.6;
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            DevBadge {}
                                                        }
                                                    }
                                                    Text {
                                                        text: Tr.w.seasons-hint;
                                                        wrap: word-wrap;
                                                        font-size: 12px;
                                                        color: Theme.foreground;
                                                        opacity: 0.6;
                                                    }
                                                    if root.season-note != "": Text {
                                                        text: root.season-note;
                                                        wrap: word-wrap;
                                                        font-size: 12px;
                                                        color: Theme.accent;
                                                    }
                                                }
                                            }
                                            // ВРЕМЕННО: предпросмотр сезонных тем, пока они в разработке — скрыт.
                                            if false: HorizontalLayout {
                                                spacing: 10px;
                                                padding-left: root.narrow-window ? 0px : 52px;
                                                alignment: start;
                                                if !root.narrow-window: Text {
                                                    text: Tr.w.season-preview;
                                                    // Узкое окно — подпись сжимается и переносится.
                                                    min-width: root.label-short;
                                                    wrap: word-wrap;
                                                    vertical-alignment: center;
                                                    color: Theme.foreground;
                                                }
                                                ComboBox {
                                                    min-width: 110px;
                                                    preferred-width: 220px;
                                                    horizontal-stretch: 1;
                                                    max-width: 220px;
                                                    model: root.season-preview-names;
                                                    current-index <=> root.season-preview-index;
                                                    selected(value) => { root.season-preview(root.season-preview-index); }
                                                }
                                                Button {
                                                    text: Tr.w.season-play;
                                                    enabled: root.season != 0;
                                                    clicked => { root.season-play(); }
                                                }
                                            }
                                            Divider {}
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text {
                                                    text: Tr.w.scale + " — " + round(root.scale-percent) + " %";
                                                    // Узкое окно — подпись сжимается и переносится.
                                                    min-width: root.label-short;
                                                    wrap: word-wrap;
                                                    vertical-alignment: center;
                                                    color: Theme.foreground;
                                                }
                                                Slider {
                                                    min-width: 140px;
                                                    preferred-width: 260px;
                                                    accessible-label: Tr.w.scale;
                                                    minimum: 80;
                                                    maximum: 150;
                                                    step: 5;
                                                    value <=> root.scale-percent;
                                                    released(value) => { root.scale-changed(value, true); }
                                                }
                                            }
                                            Text {
                                                text: Tr.w.scale-hint;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                opacity: 0.6;
                                            }
                                            // Продвинутым: рисовать видеокартой.
                                            if root.advanced: Divider {}
                                            if root.advanced: HorizontalLayout {
                                                spacing: 12px;
                                                Switch {
                                                    accessible-label: Tr.w.gpu-render;
                                                    checked <=> root.gpu-render;
                                                    toggled => { root.gpu-render-changed(self.checked); }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    Text {
                                                        text: Tr.w.gpu-render;
                                                        color: Theme.foreground;
